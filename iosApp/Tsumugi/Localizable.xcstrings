    },
    "The OPI simulator needs the practice pack's scripted interview banks. Build it with `uv run packs/build_practice.py` in tools/ and rebuild the app." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
