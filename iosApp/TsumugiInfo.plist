<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Partial Info.plist for the Tsumugi app target (INFOPLIST_FILE). Xcode still generates the rest
  (GENERATE_INFOPLIST_FILE = YES): every INFOPLIST_KEY_* build setting in project.pbxproj is merged on top of
  this file. Only keys that INFOPLIST_KEY_* cannot express live here: dictionaries and arrays.
  Deliberately outside the Tsumugi/ folder so the synchronized group doesn't copy it into the bundle as a resource.
  See docs/DECISIONS.md D-061 (ATS) and D-065 (document types).
-->
<plist version="1.0">
<dict>
	<!-- F-14: the media player keeps playing the learner's own audio with the screen locked or the app in the
	     background (AudioSessionController uses the .playback category). -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>

	<!-- F-02: plain http to the learner's own servers. NSAllowsLocalNetworking exempts unqualified names
	     (http://homeserver:11434) and .local names; IP literals are not subject to ATS. ts.net (Tailscale MagicDNS;
	     traffic is WireGuard-encrypted) and home.arpa (RFC 8375 home networks) are the only named exceptions. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
		<key>NSExceptionDomains</key>
		<dict>
			<key>ts.net</key>
			<dict>
				<key>NSIncludesSubdomains</key>
				<true/>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
			</dict>
			<key>home.arpa</key>
			<dict>
				<key>NSIncludesSubdomains</key>
				<true/>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
			</dict>
		</dict>
	</dict>

	<!-- F-42: files Tsumugi can open from Files, Mail and AirDrop. The system copies them into Documents/Inbox. -->
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<false/>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>EPUB book</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>org.idpf.epub-container</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Subtitles</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>app.tsumugi.subrip</string>
				<string>app.tsumugi.webvtt</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Anki deck package</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>app.tsumugi.apkg</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Tsumugi item bank</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Owner</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>app.tsumugi.item-bank</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>JSON item bank</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.json</string>
			</array>
		</dict>
	</array>

	<!-- Formats Tsumugi reads but does not own. EPUB is also declared by the system; this copy is a fallback. -->
	<key>UTImportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>org.idpf.epub-container</string>
			<key>UTTypeDescription</key>
			<string>EPUB book</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.zip-archive</string>
				<string>public.composite-content</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>epub</string>
				</array>
				<key>public.mime-type</key>
				<array>
					<string>application/epub+zip</string>
				</array>
			</dict>
		</dict>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>app.tsumugi.subrip</string>
			<key>UTTypeDescription</key>
			<string>SubRip subtitles</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.plain-text</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>srt</string>
				</array>
				<key>public.mime-type</key>
				<array>
					<string>application/x-subrip</string>
				</array>
			</dict>
		</dict>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>app.tsumugi.webvtt</string>
			<key>UTTypeDescription</key>
			<string>WebVTT subtitles</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.plain-text</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>vtt</string>
				</array>
				<key>public.mime-type</key>
				<array>
					<string>text/vtt</string>
				</array>
			</dict>
		</dict>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>app.tsumugi.apkg</string>
			<key>UTTypeDescription</key>
			<string>Anki deck package</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
				<string>public.archive</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>apkg</string>
				</array>
			</dict>
		</dict>
	</array>

	<!-- Tsumugi's own format: an exam item bank (tools/items). Plain .json banks open through public.json above. -->
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>app.tsumugi.item-bank</string>
			<key>UTTypeDescription</key>
			<string>Tsumugi item bank</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.json</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>tsumugibank</string>
				</array>
			</dict>
		</dict>
	</array>
</dict>
</plist>
