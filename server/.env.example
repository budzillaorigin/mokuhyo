# Copy to .env and fill in. Every setting is optional except the two secrets.

# Required: a long random string (e.g. `openssl rand -hex 32`). Changing it signs everyone out.
TSUMUGI_JWT_SECRET=
# Required for docker compose: the Postgres password.
POSTGRES_PASSWORD=

# Public address of this server (used in email-verification links) and, for passkeys, its domain and origins.
TSUMUGI_PUBLIC_URL=https://sync.example.com
TSUMUGI_DOMAIN=sync.example.com
TSUMUGI_RP_ID=sync.example.com
TSUMUGI_RP_NAME=Tsumugi
TSUMUGI_RP_ORIGINS=https://sync.example.com

# Optional SMTP for email verification. Without it the link is written to the server log.
# TSUMUGI_SMTP_HOST=smtp.example.com
# TSUMUGI_SMTP_PORT=587
# TSUMUGI_SMTP_USER=
# TSUMUGI_SMTP_PASSWORD=
# TSUMUGI_SMTP_FROM=tsumugi@example.com

# Fair-use limits (defaults shown).
# TSUMUGI_MAX_PUSH_CHANGES=5000
# TSUMUGI_MAX_BODY_BYTES=8388608
# TSUMUGI_BLOB_QUOTA_BYTES=209715200
# TSUMUGI_MAX_BLOB_BYTES=20971520
# TSUMUGI_RATE_LIMIT_PER_MINUTE=600
# TSUMUGI_ALLOW_REGISTRATION=true
# TSUMUGI_PORT=8080
