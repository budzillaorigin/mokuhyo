# Drafting endpoint for every tools/ content script and tools/models/eval_speaking.py (BRIEF §7.1).
# The owner's Ollama server on the RTX 5090 machine (LAN). Copy to tools/.env to override.
LLM_ENDPOINT=http://<server-ip>:11434/v1
LLM_MODEL=mistral-small3.2:24b-instruct-2506-q8_0
# Second-opinion validator / fallback after three consecutive primary failures.
LLM_CHECK_MODEL=gpt-oss:20b
