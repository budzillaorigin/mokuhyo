-- Read-only dictionary content pack. Built by tools/packs/build_*.py, which execute the CREATE
-- statements in this file verbatim, so this file is the single source of truth for the pack schema.
-- JSON-array columns hold string arrays as JSON; an empty string means [] (or ["*"] for applies_* columns).

CREATE TABLE pack_meta (
    key TEXT NOT NULL PRIMARY KEY,
    value TEXT NOT NULL
);

-- JMdict entry. id = JMdict ent_seq. rank: lower is more common (derived from priority tags).
CREATE TABLE entry (
    id INTEGER NOT NULL PRIMARY KEY,
    is_common INTEGER NOT NULL,
    rank INTEGER NOT NULL,
    jlpt INTEGER
);

CREATE TABLE entry_kanji (
    entry_id INTEGER NOT NULL,
    ord INTEGER NOT NULL,
    text TEXT NOT NULL,
    is_common INTEGER NOT NULL,
    tags TEXT NOT NULL,
    PRIMARY KEY (entry_id, ord)
) WITHOUT ROWID;
CREATE INDEX entry_kanji_text ON entry_kanji(text);

-- search = reading folded to hiragana (search only, per CLAUDE.md rule 7).
-- applies_to = JSON array of kanji forms this reading belongs to; ["*"] = all.
CREATE TABLE entry_kana (
    entry_id INTEGER NOT NULL,
    ord INTEGER NOT NULL,
    text TEXT NOT NULL,
    search TEXT NOT NULL,
    is_common INTEGER NOT NULL,
    tags TEXT NOT NULL,
    applies_to TEXT NOT NULL,
    PRIMARY KEY (entry_id, ord)
) WITHOUT ROWID;
CREATE INDEX entry_kana_search ON entry_kana(search);

CREATE TABLE sense (
    entry_id INTEGER NOT NULL,
    ord INTEGER NOT NULL,
    pos TEXT NOT NULL,
    glosses TEXT NOT NULL,
    misc TEXT NOT NULL,
    field TEXT NOT NULL,
    dialect TEXT NOT NULL,
    info TEXT NOT NULL,
    applies_kanji TEXT NOT NULL,
    applies_kana TEXT NOT NULL,
    related TEXT NOT NULL,
    PRIMARY KEY (entry_id, ord)
) WITHOUT ROWID;

-- English reverse index (portable replacement for FTS; see DECISIONS D-009).
-- term = lowercased gloss word, or a whole lowercased gloss prefixed with '=' for exact-gloss hits.
CREATE TABLE gloss_index (
    term TEXT NOT NULL,
    entry_id INTEGER NOT NULL,
    score INTEGER NOT NULL,
    PRIMARY KEY (term, entry_id)
) WITHOUT ROWID;

-- KANJIDIC2. JSON arrays for meanings/readings. jlpt_new from community lists (unofficial).
CREATE TABLE kanji (
    literal TEXT NOT NULL PRIMARY KEY,
    grade INTEGER,
    stroke_count INTEGER NOT NULL,
    freq INTEGER,
    jlpt_old INTEGER,
    jlpt_new INTEGER,
    heisig INTEGER,
    heisig6 INTEGER,
    meanings TEXT NOT NULL,
    onyomi TEXT NOT NULL,
    kunyomi TEXT NOT NULL,
    nanori TEXT NOT NULL
);

-- KRADFILE (kanji -> components) and RADKFILE (radical stroke counts).
CREATE TABLE radical (
    radical TEXT NOT NULL PRIMARY KEY,
    stroke_count INTEGER NOT NULL
);

CREATE TABLE kanji_component (
    kanji TEXT NOT NULL,
    radical TEXT NOT NULL,
    PRIMARY KEY (kanji, radical)
) WITHOUT ROWID;
CREATE INDEX kanji_component_radical ON kanji_component(radical);

-- Words whose written form contains the kanji (precomputed for the kanji view).
CREATE TABLE kanji_word (
    kanji TEXT NOT NULL,
    entry_id INTEGER NOT NULL,
    rank INTEGER NOT NULL,
    PRIMARY KEY (kanji, entry_id)
) WITHOUT ROWID;

-- KanjiVG stroke paths in the 109x109 KanjiVG coordinate space (SVG path data).
CREATE TABLE stroke (
    kanji TEXT NOT NULL,
    ord INTEGER NOT NULL,
    path TEXT NOT NULL,
    type TEXT NOT NULL,
    PRIMARY KEY (kanji, ord)
) WITHOUT ROWID;

-- JmdictFurigana, only for forms containing kanji. segments = "ruby=rt|ruby|ruby=rt" (no "=rt" for kana runs),
-- e.g. 食べ物/たべもの -> "食=た|べ|物=もの". Decoded by app.tsumugi.dictionary.FuriganaCodec.
CREATE TABLE furigana (
    text TEXT NOT NULL,
    reading TEXT NOT NULL,
    segments TEXT NOT NULL,
    PRIMARY KEY (text, reading)
) WITHOUT ROWID;

-- Kanjium pitch accent: accents = comma-separated downstep positions (0 = heiban).
CREATE TABLE pitch (
    text TEXT NOT NULL,
    reading TEXT NOT NULL,
    accents TEXT NOT NULL,
    PRIMARY KEY (text, reading)
) WITHOUT ROWID;

-- Tatoeba jpn-eng pairs.
CREATE TABLE sentence (
    id INTEGER NOT NULL PRIMARY KEY,
    ja TEXT NOT NULL,
    en TEXT NOT NULL,
    jlpt INTEGER
);

CREATE TABLE sentence_word (
    entry_id INTEGER NOT NULL,
    sentence_id INTEGER NOT NULL,
    PRIMARY KEY (entry_id, sentence_id)
) WITHOUT ROWID;

metaValue:
SELECT value FROM pack_meta WHERE key = ?;

entriesByIds:
SELECT * FROM entry WHERE id IN ?;

kanjiFormsFor:
SELECT * FROM entry_kanji WHERE entry_id IN ? ORDER BY entry_id, ord;

kanaFormsFor:
SELECT * FROM entry_kana WHERE entry_id IN ? ORDER BY entry_id, ord;

sensesFor:
SELECT * FROM sense WHERE entry_id IN ? ORDER BY entry_id, ord;

-- Entries whose kanji form is in :kanji or whose folded reading is in :kana, with the matched text.
formsExact:
SELECT entry_id, text FROM entry_kanji WHERE text IN :kanji
UNION ALL
SELECT entry_id, search FROM entry_kana WHERE search IN :kana;

-- Everything a result row needs in one query. glosses = the first three senses' JSON gloss arrays joined
-- by U+001F (senses are clustered by (entry_id, ord), so they concatenate in sense order).
-- nullif(…, '') only tells SQLDelight these subquery columns can be NULL (kana-only words have no kanji).
summariesByIds:
SELECT e.id, e.is_common, e.jlpt,
    nullif((SELECT text FROM entry_kanji WHERE entry_id = e.id ORDER BY ord LIMIT 1), '') AS kanji,
    nullif((SELECT text FROM entry_kana WHERE entry_id = e.id ORDER BY ord LIMIT 1), '') AS kana,
    nullif((SELECT misc FROM sense WHERE entry_id = e.id AND ord = 0), '') AS misc,
    nullif((SELECT group_concat(glosses, char(31)) FROM sense WHERE entry_id = e.id AND ord < 3), '') AS glosses
FROM entry e WHERE e.id IN ?;

posFor:
SELECT entry_id, pos FROM sense WHERE entry_id IN ?;

idsByKanjiPrefix:
SELECT entry_kanji.entry_id FROM entry_kanji JOIN entry ON entry.id = entry_kanji.entry_id
WHERE text >= :prefix AND text < :prefixEnd
GROUP BY entry_kanji.entry_id ORDER BY MIN(entry.rank), MIN(length(text)) LIMIT :limit;

idsByKanaPrefix:
SELECT entry_kana.entry_id FROM entry_kana JOIN entry ON entry.id = entry_kana.entry_id
WHERE search >= :prefix AND search < :prefixEnd
GROUP BY entry_kana.entry_id ORDER BY MIN(entry.rank), MIN(length(search)) LIMIT :limit;

idsByGlossTerms:
SELECT gloss_index.entry_id, SUM(score) AS total FROM gloss_index JOIN entry ON entry.id = gloss_index.entry_id
WHERE term IN :terms
GROUP BY gloss_index.entry_id
HAVING COUNT(DISTINCT term) >= :required
ORDER BY total DESC, MIN(entry.rank) LIMIT :limit;

kanjiByLiteral:
SELECT * FROM kanji WHERE literal IN ?;

allRadicals:
SELECT * FROM radical ORDER BY stroke_count, radical;

kanjiWithAllRadicals:
SELECT kanji.* FROM kanji_component JOIN kanji ON kanji.literal = kanji_component.kanji
WHERE kanji_component.radical IN :radicals
GROUP BY kanji_component.kanji
HAVING COUNT(DISTINCT kanji_component.radical) = :count
ORDER BY kanji.stroke_count, coalesce(kanji.freq, 99999);

radicalsCooccurringWith:
SELECT DISTINCT radical FROM kanji_component WHERE kanji IN :kanji;

componentsOf:
SELECT radical FROM kanji_component WHERE kanji = ?;

strokesFor:
SELECT * FROM stroke WHERE kanji = ? ORDER BY ord;

wordsWithKanji:
SELECT entry_id FROM kanji_word WHERE kanji = ? ORDER BY rank LIMIT ?;

furiganaFor:
SELECT segments FROM furigana WHERE text = ? AND reading = ?;

pitchFor:
SELECT accents FROM pitch WHERE text = ? AND reading = ?;

sentencesForEntry:
SELECT sentence.* FROM sentence_word JOIN sentence ON sentence.id = sentence_word.sentence_id
WHERE sentence_word.entry_id = ?
ORDER BY coalesce(sentence.jlpt, 0) DESC, length(sentence.ja)
LIMIT ?;

insertMeta:
INSERT OR REPLACE INTO pack_meta(key, value) VALUES (?, ?);

insertEntry:
INSERT INTO entry VALUES ?;

insertKanjiForm:
INSERT INTO entry_kanji VALUES ?;

insertKanaForm:
INSERT INTO entry_kana VALUES ?;

insertSense:
INSERT INTO sense VALUES ?;

insertGloss:
INSERT INTO gloss_index VALUES ?;

insertKanji:
INSERT INTO kanji VALUES ?;

insertRadical:
INSERT INTO radical VALUES ?;

insertComponent:
INSERT INTO kanji_component VALUES ?;

insertKanjiWord:
INSERT INTO kanji_word VALUES ?;

insertStroke:
INSERT INTO stroke VALUES ?;

insertFurigana:
INSERT INTO furigana VALUES ?;

insertPitch:
INSERT INTO pitch VALUES ?;

insertSentence:
INSERT INTO sentence VALUES ?;

insertSentenceWord:
INSERT INTO sentence_word VALUES ?;
