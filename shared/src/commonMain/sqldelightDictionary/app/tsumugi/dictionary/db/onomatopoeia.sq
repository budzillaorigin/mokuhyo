-- Onomatopoeia module (BRIEF_V2 §6.8, DECISIONS D-235..D-237): extra tables in the dictionary pack, built by
-- tools/packs/build_onomatopoeia.py, which executes the CREATE statements in this file verbatim (single source of
-- truth). Packs built before Phase 12 lack these tables; the app then shows an honest empty state.

-- One row per theme, with its original SVG glyph (one per theme, not per word). ord = display order.
CREATE TABLE onomatopoeia_theme (
    id TEXT NOT NULL PRIMARY KEY,
    ord INTEGER NOT NULL,
    title_en TEXT NOT NULL,
    title_ja TEXT NOT NULL,
    blurb TEXT NOT NULL,
    svg TEXT NOT NULL
);

-- One row per JMdict entry tagged on-mim. ord: frequency order (1 = most frequent, by entry.rank).
-- text: the headword shown (first kana form). variants: JSON array of the other kana and kanji forms.
-- type: GIONGO (擬音語) | GITAIGO (擬態語) | GIJOUGO (擬情語). theme: an onomatopoeia_theme id.
-- gloss: JSON array of the English glosses of the first on-mim sense (JMdict, CC BY-SA 4.0).
-- feel / feel_ja: our own one-line description ('' when not written yet). examples: JSON array of sentence ids in the
-- sentence table (Tatoeba, CC BY 2.0 FR). source: "llm" (theme, type and feel drafted, badge shown) | "verified".
CREATE TABLE onomatopoeia (
    entry_id INTEGER NOT NULL PRIMARY KEY,
    ord INTEGER NOT NULL,
    text TEXT NOT NULL,
    variants TEXT NOT NULL,
    type TEXT NOT NULL,
    theme TEXT NOT NULL,
    gloss TEXT NOT NULL,
    feel TEXT NOT NULL,
    feel_ja TEXT NOT NULL,
    examples TEXT NOT NULL,
    source TEXT NOT NULL
);
CREATE INDEX onomatopoeia_by_theme ON onomatopoeia(theme, ord);

onomatopoeiaThemes:
SELECT * FROM onomatopoeia_theme ORDER BY ord;

onomatopoeiaAll:
SELECT * FROM onomatopoeia ORDER BY ord;

onomatopoeiaByTheme:
SELECT * FROM onomatopoeia WHERE theme = ? ORDER BY ord;

onomatopoeiaByIds:
SELECT * FROM onomatopoeia WHERE entry_id IN ?;

onomatopoeiaSentences:
SELECT id, ja, en FROM sentence WHERE id IN ?;

insertOnomatopoeiaTheme:
INSERT INTO onomatopoeia_theme VALUES ?;

insertOnomatopoeia:
INSERT INTO onomatopoeia VALUES ?;
