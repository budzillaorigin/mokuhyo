-- Kanji explorer and functional components (BRIEF_V2 §6.15, DECISIONS D-280…D-283): extra tables in the dictionary pack,
-- built by tools/packs/build_phonetics.py, which executes the CREATE statements in this file verbatim (single source of
-- truth). Packs built before Phase 13 lack these tables; the app then falls back to KRADFILE components and shows no
-- roles or sound series.

-- KanjiVG component tree, flattened: every named element (kvg:element) under a kanji, at its shallowest depth
-- (1 = a direct part). position: KanjiVG's position of the depth-1 part it sits in (left, right, top, bottom, kamae…;
-- '' when none). Used both ways: a kanji's parts, and the kanji that contain an element ("used in").
CREATE TABLE kanji_element (
    kanji TEXT NOT NULL,
    element TEXT NOT NULL,
    depth INTEGER NOT NULL,
    position TEXT NOT NULL,
    PRIMARY KEY (kanji, element)
) WITHOUT ROWID;
CREATE INDEX kanji_element_by_element ON kanji_element(element, depth);

-- Role of each direct part of a kanji: SEMANTIC | PHONETIC | FORM (form-only). Derived heuristically from the
-- KanjiVG tree and KANJIDIC2 on'yomi (a shared part with the same or a related on'yomi is phonetic).
-- evidence: JSON {"match": "same"|"related"|"shared", "reading": "セイ", "kvgPhon": bool, "kvgRadical": bool}
-- ('{}' for form-only parts). series: the phonetic_series id the kanji belongs to through this part ('' otherwise).
-- source: "derived" (shown with a "derived" label) | "verified" (its sound series was reviewed with items/review.py).
CREATE TABLE kanji_component_role (
    kanji TEXT NOT NULL,
    component TEXT NOT NULL,
    ord INTEGER NOT NULL,
    role TEXT NOT NULL,
    evidence TEXT NOT NULL,
    series TEXT NOT NULL,
    source TEXT NOT NULL,
    PRIMARY KEY (kanji, component)
) WITHOUT ROWID;
CREATE INDEX kanji_component_role_series ON kanji_component_role(series);

-- A sound series (声符 family): kanji sharing the phonetic component [phonetic] with matching or related on'yomi.
-- readings: JSON array of the family's on'yomi (katakana), most shared first. members: JSON array of
-- {"k": kanji, "on": [on'yomi], "match": "self"|"same"|"related"|"shared"}, the head (the phonetic itself, when it is a
-- kanji) first, then by frequency. source: "derived" | "verified" (reviewed in tools/packs/phonetics/series.json).
CREATE TABLE phonetic_series (
    phonetic TEXT NOT NULL PRIMARY KEY,
    readings TEXT NOT NULL,
    members TEXT NOT NULL,
    size INTEGER NOT NULL,
    source TEXT NOT NULL
);

elementsOf:
SELECT * FROM kanji_element WHERE kanji = ? ORDER BY depth, element;

kanjiContaining:
SELECT kanji_element.kanji FROM kanji_element JOIN kanji ON kanji.literal = kanji_element.kanji
WHERE kanji_element.element = ? AND kanji_element.kanji != kanji_element.element
ORDER BY kanji_element.depth, coalesce(kanji.freq, 99999), kanji.stroke_count
LIMIT ?;

kanjiContainingAll:
SELECT kanji_element.kanji FROM kanji_element JOIN kanji ON kanji.literal = kanji_element.kanji
WHERE kanji_element.element IN :elements
GROUP BY kanji_element.kanji
HAVING COUNT(DISTINCT kanji_element.element) = :count
ORDER BY coalesce(kanji.freq, 99999), kanji.stroke_count
LIMIT :limit;

-- Kanji containing [part] anywhere in their KanjiVG tree, or listing it as a KRADFILE component (under [radical], the
-- RADKFILE key, which is a stand-in kanji for some radicals: 汁 for 氵).
kanjiWithPart:
SELECT kanji FROM kanji_element WHERE element = :part
UNION
SELECT kanji FROM kanji_component WHERE radical = :radical;

rolesOf:
SELECT * FROM kanji_component_role WHERE kanji = ? ORDER BY ord;

seriesById:
SELECT * FROM phonetic_series WHERE phonetic = ?;

seriesByIds:
SELECT * FROM phonetic_series WHERE phonetic IN ?;

allSeries:
SELECT * FROM phonetic_series ORDER BY size DESC, phonetic;

insertElement:
INSERT INTO kanji_element VALUES ?;

insertRole:
INSERT INTO kanji_component_role VALUES ?;

insertSeries:
INSERT INTO phonetic_series VALUES ?;
