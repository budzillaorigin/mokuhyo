-- Expression thesaurus and collocations (BRIEF_V2 §6.13; DECISIONS D-272, D-273), tables in dictionary.sqlite.
-- tools/packs/build_thesaurus.py writes expression_* from tools/packs/thesaurus/clusters/*.json; build_collocations.py
-- writes collocation from the tokenized Tatoeba corpus. Each builder replaces only its own tables (this file is the
-- single source of truth for their CREATE statements). Packs built before Phase 13 lack them: every repository call
-- then returns empty and the UI shows an honest empty state.

-- A cluster of expressions for one scene or emotion (怒り, 雨 …). kind: emotion | scene. Drafted by an LLM:
-- source llm until reviewed (verified 1).
CREATE TABLE expression_cluster (
    id TEXT NOT NULL PRIMARY KEY,
    ord INTEGER NOT NULL,
    kind TEXT NOT NULL,
    ja TEXT NOT NULL,
    reading TEXT NOT NULL,
    en TEXT NOT NULL,
    description TEXT NOT NULL,
    source TEXT NOT NULL,
    verified INTEGER NOT NULL
);

-- One expression. entry_id: the JMdict entry it resolves to (null for set phrases JMdict lacks); gloss: that entry's
-- first-sense glosses. register: casual | neutral | formal | literary. intensity 1–3. example_*: the drafted example
-- (labeled with the cluster's source); Tatoeba examples are in expression_example.
CREATE TABLE expression (
    cluster_id TEXT NOT NULL,
    ord INTEGER NOT NULL,
    text TEXT NOT NULL,
    reading TEXT NOT NULL,
    entry_id INTEGER,
    gloss TEXT NOT NULL,
    nuance TEXT NOT NULL,
    register TEXT NOT NULL,
    intensity INTEGER NOT NULL,
    example_ja TEXT NOT NULL,
    example_en TEXT NOT NULL,
    PRIMARY KEY (cluster_id, ord)
) WITHOUT ROWID;
CREATE INDEX expression_entry ON expression(entry_id);

-- Up to two Tatoeba sentences (the pack's own `sentence` table) per expression.
CREATE TABLE expression_example (
    cluster_id TEXT NOT NULL,
    ord INTEGER NOT NULL,
    sentence_id INTEGER NOT NULL,
    PRIMARY KEY (cluster_id, ord, sentence_id)
) WITHOUT ROWID;

-- The plain words a cluster improves on, as analyzer lemmas (怒る, 嬉しい): the writing studio flags them.
CREATE TABLE expression_plain (
    lemma TEXT NOT NULL,
    cluster_id TEXT NOT NULL,
    PRIMARY KEY (lemma, cluster_id)
) WITHOUT ROWID;

-- Collocations from Tatoeba (D-273). pattern: NV (noun + particle + verb; a = noun, b = verb), AN (adjective or
-- な-adjective + noun; a = adjective, b = noun), AV (adverb + verb; a = adverb, b = verb). particle: the case particle
-- for NV (を が に で と へ から), "" otherwise. a_text/b_text: lemmas. count: sentences with the pair; pmi: log2
-- pointwise mutual information of the pair over pairs of that pattern. example_id: a short Tatoeba sentence with it.
CREATE TABLE collocation (
    a_id INTEGER NOT NULL,
    b_id INTEGER NOT NULL,
    pattern TEXT NOT NULL,
    particle TEXT NOT NULL,
    a_text TEXT NOT NULL,
    b_text TEXT NOT NULL,
    count INTEGER NOT NULL,
    pmi REAL NOT NULL,
    example_id INTEGER,
    PRIMARY KEY (a_id, b_id, pattern, particle)
) WITHOUT ROWID;
CREATE INDEX collocation_b ON collocation(b_id);

clusters:
SELECT * FROM expression_cluster ORDER BY ord;

clusterById:
SELECT * FROM expression_cluster WHERE id = ?;

expressionsOf:
SELECT * FROM expression WHERE cluster_id = ? ORDER BY ord;

examplesOf:
SELECT e.ord, s.id, s.ja, s.en FROM expression_example e JOIN sentence s ON s.id = e.sentence_id WHERE e.cluster_id = ? ORDER BY e.ord, s.id;

clustersForLemmas:
SELECT lemma, cluster_id FROM expression_plain WHERE lemma IN ?;

clustersForEntry:
SELECT DISTINCT cluster_id FROM expression WHERE entry_id = ?;

searchClusters:
SELECT DISTINCT c.* FROM expression_cluster c LEFT JOIN expression e ON e.cluster_id = c.id
WHERE c.ja LIKE ('%' || :q || '%') OR c.reading LIKE ('%' || :q || '%') OR c.en LIKE ('%' || :q || '%') OR e.text LIKE ('%' || :q || '%') OR e.reading LIKE ('%' || :q || '%')
ORDER BY c.ord;

collocationsOf:
SELECT * FROM collocation WHERE a_id = :id OR b_id = :id ORDER BY pmi * min(count, 20) DESC LIMIT :limit;

collocationSentence:
SELECT id, ja, en FROM sentence WHERE id = ?;
