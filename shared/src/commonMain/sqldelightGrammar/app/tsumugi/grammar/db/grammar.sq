-- Read-only grammar content pack (content/packs/grammar.sqlite), built by tools/packs/build_grammar.py from
-- tools/packs/grammar/n*.json, which executes the CREATE statements in this file verbatim.

CREATE TABLE pack_meta (
    key TEXT NOT NULL PRIMARY KEY,
    value TEXT NOT NULL
);

-- source: "llm" (drafted, awaiting human review) | "verified" (reviewed with tools/items/review.py).
-- mistakes/related/links: JSON string arrays. textbooks: JSON object, e.g. {"genki":"L7"} (chapter refs only).
CREATE TABLE grammar_point (
    id TEXT NOT NULL PRIMARY KEY,
    jlpt INTEGER NOT NULL,
    ord INTEGER NOT NULL,
    title TEXT NOT NULL,
    structure TEXT NOT NULL,
    meaning TEXT NOT NULL,
    nuance TEXT NOT NULL,
    mistakes TEXT NOT NULL,
    related TEXT NOT NULL,
    textbooks TEXT NOT NULL,
    source TEXT NOT NULL
);
CREATE INDEX grammar_point_level ON grammar_point(jlpt, ord);

-- Example sentences. [blank_start, blank_end) is the span of the grammar construction in ja (UTF-16 offsets),
-- used for cloze reviews. source: "tatoeba" (human-written, CC BY 2.0 FR; tatoeba_id set) or "llm".
CREATE TABLE grammar_example (
    point_id TEXT NOT NULL,
    ord INTEGER NOT NULL,
    ja TEXT NOT NULL,
    en TEXT NOT NULL,
    blank_start INTEGER NOT NULL,
    blank_end INTEGER NOT NULL,
    source TEXT NOT NULL,
    tatoeba_id INTEGER,
    PRIMARY KEY (point_id, ord)
) WITHOUT ROWID;

-- Regexes that find the construction in text (grammar detection in the reader; cloze answer checking).
CREATE TABLE grammar_pattern (
    point_id TEXT NOT NULL,
    ord INTEGER NOT NULL,
    regex TEXT NOT NULL,
    PRIMARY KEY (point_id, ord)
) WITHOUT ROWID;

metaValue:
SELECT value FROM pack_meta WHERE key = ?;

pointsAtLevel:
SELECT * FROM grammar_point WHERE jlpt = ? ORDER BY ord;

allPoints:
SELECT * FROM grammar_point ORDER BY jlpt DESC, ord;

pointsByIds:
SELECT * FROM grammar_point WHERE id IN ?;

examplesFor:
SELECT * FROM grammar_example WHERE point_id = ? ORDER BY ord;

patternsFor:
SELECT regex FROM grammar_pattern WHERE point_id = ? ORDER BY ord;

allPatterns:
SELECT * FROM grammar_pattern ORDER BY point_id, ord;

insertPoint:
INSERT INTO grammar_point VALUES ?;

insertExample:
INSERT INTO grammar_example VALUES ?;

insertPattern:
INSERT INTO grammar_pattern VALUES ?;

insertMeta:
INSERT OR REPLACE INTO pack_meta(key, value) VALUES (?, ?);
