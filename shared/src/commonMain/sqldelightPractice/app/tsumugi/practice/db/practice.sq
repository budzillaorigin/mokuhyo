-- Read-only speaking & listening practice pack (content/packs/practice.sqlite), built by
-- tools/packs/build_practice.py, which executes the CREATE statements in this file verbatim.
-- source: "llm" (drafted, awaiting human review; shown with an AI-generated badge) | "verified" | "derived"
-- (computed from licensed data, e.g. minimal pairs from JMdict + Kanjium). JSON columns hold arrays/objects.

CREATE TABLE pack_meta (
    key TEXT NOT NULL PRIMARY KEY,
    value TEXT NOT NULL
);

-- Role-play situations (BRIEF §5.10). register: casual | polite | keigo. ilr: "0+".."3".
-- goals/phrases: JSON string arrays. vocabulary: JSON [{"text":"…","reading":"…","entryId":123}].
CREATE TABLE scenario (
    id TEXT NOT NULL PRIMARY KEY,
    ord INTEGER NOT NULL,
    title_en TEXT NOT NULL,
    title_ja TEXT NOT NULL,
    jlpt INTEGER NOT NULL,
    ilr TEXT NOT NULL,
    category TEXT NOT NULL,
    setting TEXT NOT NULL,
    learner_role TEXT NOT NULL,
    partner_role TEXT NOT NULL,
    register TEXT NOT NULL,
    goals TEXT NOT NULL,
    vocabulary TEXT NOT NULL,
    phrases TEXT NOT NULL,
    system_prompt TEXT NOT NULL,
    source TEXT NOT NULL
);

-- Scripted fallback conversation used when no language model is available (BRIEF §3.5).
-- partner_ja/partner_en: what the partner says; intent: what the learner is expected to do next;
-- sample_answer: one acceptable learner reply. accept: JSON string array of other acceptable replies (varied
-- wording, shorter/longer answers) so a fallback matcher isn't tied to the sample line (BRIEF_V2 Appendix A).
CREATE TABLE scripted_turn (
    scenario_id TEXT NOT NULL,
    ord INTEGER NOT NULL,
    partner_ja TEXT NOT NULL,
    partner_en TEXT NOT NULL,
    intent TEXT NOT NULL,
    sample_answer TEXT NOT NULL,
    accept TEXT NOT NULL,
    PRIMARY KEY (scenario_id, ord)
) WITHOUT ROWID;

-- OPI practice question bank by ILR level. phase: WARM_UP | LEVEL_CHECK | PROBE | ROLE_PLAY | WIND_DOWN.
-- domain: DLI-style topic domain (BRIEF_V2 §6.16): personal | family | work | daily_life | travel | current_events |
-- hypothetical | abstract | situation, or '' when untagged.
CREATE TABLE opi_question (
    ilr TEXT NOT NULL,
    ord INTEGER NOT NULL,
    phase TEXT NOT NULL,
    prompt_ja TEXT NOT NULL,
    prompt_en TEXT NOT NULL,
    note TEXT NOT NULL,
    source TEXT NOT NULL,
    domain TEXT NOT NULL,
    PRIMARY KEY (ilr, ord)
) WITHOUT ROWID;

-- Self-rating checklist per ILR level, paraphrased from the public-domain ILR speaking descriptors.
CREATE TABLE opi_checklist (
    ilr TEXT NOT NULL,
    ord INTEGER NOT NULL,
    statement TEXT NOT NULL,
    PRIMARY KEY (ilr, ord)
) WITHOUT ROWID;

-- Two-speaker listening dialogues (BRIEF §5.9). speakers: JSON [{"id":"A","name":"…","voice":"female","age":"adult",
-- "hint":"…"}] (hint: optional delivery note for the renderer/reviewer). style: scripted | natural (BRIEF_V2 §6.10:
-- unscripted-sounding speech with fillers, backchannels, restarts and overlaps).
CREATE TABLE dialogue (
    id TEXT NOT NULL PRIMARY KEY,
    ord INTEGER NOT NULL,
    title TEXT NOT NULL,
    jlpt INTEGER NOT NULL,
    topic TEXT NOT NULL,
    speakers TEXT NOT NULL,
    source TEXT NOT NULL,
    style TEXT NOT NULL
);

-- gaps: JSON [{"text":"…","start":n,"end":n,"entryId":123}] (UTF-16 offsets into ja).
-- chunks: JSON string array whose concatenation equals ja (for "order the chunks").
-- fillers: JSON [[start,end],…] UTF-16 spans of fillers/disfluencies (えっと, あの, restarts) the transcript greys.
-- overlap: 1 when the line starts before the previous one ends (backchannels, interruptions).
CREATE TABLE dialogue_line (
    dialogue_id TEXT NOT NULL,
    ord INTEGER NOT NULL,
    speaker TEXT NOT NULL,
    ja TEXT NOT NULL,
    en TEXT NOT NULL,
    gaps TEXT NOT NULL,
    chunks TEXT NOT NULL,
    fillers TEXT NOT NULL,
    overlap INTEGER NOT NULL,
    PRIMARY KEY (dialogue_id, ord)
) WITHOUT ROWID;

-- choices: JSON string array; answer: index into choices.
CREATE TABLE dialogue_question (
    dialogue_id TEXT NOT NULL,
    ord INTEGER NOT NULL,
    question_en TEXT NOT NULL,
    choices TEXT NOT NULL,
    answer INTEGER NOT NULL,
    PRIMARY KEY (dialogue_id, ord)
) WITHOUT ROWID;

-- Minimal pairs (Fluent Forever ear training), derived from JMdict readings + Kanjium pitch.
-- category: LENGTH | GEMINATION | VOICING | NASAL | PITCH. For PITCH pairs reading_a = reading_b.
CREATE TABLE minimal_pair (
    id INTEGER NOT NULL PRIMARY KEY,
    category TEXT NOT NULL,
    entry_a INTEGER NOT NULL,
    text_a TEXT NOT NULL,
    reading_a TEXT NOT NULL,
    accent_a INTEGER,
    gloss_a TEXT NOT NULL,
    entry_b INTEGER NOT NULL,
    text_b TEXT NOT NULL,
    reading_b TEXT NOT NULL,
    accent_b INTEGER,
    gloss_b TEXT NOT NULL,
    rank INTEGER NOT NULL
);
CREATE INDEX minimal_pair_category ON minimal_pair(category, rank);

-- Speaking drill sets (BRIEF_V2 §6.10, Swotter format): prompt → pause → model answer → repeat.
-- kind: grammar (grammar-pack examples) | dialogue (listening-dialogue lines). source: the set's provenance
-- ("derived" when every item is human-translated Tatoeba text, "llm" when any item is AI-drafted).
CREATE TABLE drill_set (
    id TEXT NOT NULL PRIMARY KEY,
    ord INTEGER NOT NULL,
    title TEXT NOT NULL,
    jlpt INTEGER NOT NULL,
    kind TEXT NOT NULL,
    description TEXT NOT NULL,
    source TEXT NOT NULL
);

-- prompt_en: the cue (spoken with system TTS or shown); answer_ja: the model answer; audio_key: the pre-rendered clip
-- of the answer (grammar/<point>/<ord> or dialogue/<id>/<ord>, docs/CONTENT_PACKS.md); ref: g:<point id> or d:<dialogue id>.
CREATE TABLE drill_item (
    set_id TEXT NOT NULL,
    ord INTEGER NOT NULL,
    prompt_en TEXT NOT NULL,
    answer_ja TEXT NOT NULL,
    audio_key TEXT NOT NULL,
    ref TEXT NOT NULL,
    source TEXT NOT NULL,
    PRIMARY KEY (set_id, ord)
) WITHOUT ROWID;

metaValue:
SELECT value FROM pack_meta WHERE key = ?;

allScenarios:
SELECT * FROM scenario ORDER BY ord;

scenariosAtLevel:
SELECT * FROM scenario WHERE jlpt = ? ORDER BY ord;

scenarioById:
SELECT * FROM scenario WHERE id = ?;

scriptedTurns:
SELECT * FROM scripted_turn WHERE scenario_id = ? ORDER BY ord;

opiQuestions:
SELECT * FROM opi_question WHERE ilr = ? ORDER BY ord;

opiChecklist:
SELECT statement FROM opi_checklist WHERE ilr = ? ORDER BY ord;

allDialogues:
SELECT * FROM dialogue ORDER BY ord;

dialoguesAtLevel:
SELECT * FROM dialogue WHERE jlpt = ? ORDER BY ord;

dialogueById:
SELECT * FROM dialogue WHERE id = ?;

dialogueLines:
SELECT * FROM dialogue_line WHERE dialogue_id = ? ORDER BY ord;

dialogueQuestions:
SELECT * FROM dialogue_question WHERE dialogue_id = ? ORDER BY ord;

allDrillSets:
SELECT * FROM drill_set ORDER BY ord;

drillSetsAtLevel:
SELECT * FROM drill_set WHERE jlpt = ? ORDER BY ord;

drillSetById:
SELECT * FROM drill_set WHERE id = ?;

drillItems:
SELECT * FROM drill_item WHERE set_id = ? ORDER BY ord;

minimalPairs:
SELECT * FROM minimal_pair ORDER BY rank LIMIT ?;

minimalPairsIn:
SELECT * FROM minimal_pair WHERE category = ? ORDER BY rank LIMIT ?;

insertMeta:
INSERT OR REPLACE INTO pack_meta(key, value) VALUES (?, ?);

insertScenario:
INSERT INTO scenario VALUES ?;

insertTurn:
INSERT INTO scripted_turn VALUES ?;

insertOpiQuestion:
INSERT INTO opi_question VALUES ?;

insertOpiChecklist:
INSERT INTO opi_checklist VALUES ?;

insertDialogue:
INSERT INTO dialogue VALUES ?;

insertLine:
INSERT INTO dialogue_line VALUES ?;

insertQuestion:
INSERT INTO dialogue_question VALUES ?;

insertPair:
INSERT INTO minimal_pair VALUES ?;

insertDrillSet:
INSERT INTO drill_set VALUES ?;

insertDrillItem:
INSERT INTO drill_item VALUES ?;
