-- Read-only interest and domain tracks pack (content/packs/tracks.sqlite, BRIEF_V2 §6.5), built by
-- tools/packs/build_tracks.py from tools/packs/tracks/<track>.json, which executes the CREATE statements in this
-- file verbatim. source: "llm" (drafted, awaiting human review; shown with an AI-generated badge) | "verified" |
-- "derived" (computed from licensed data, e.g. a kanji subset from JMdict + KANJIDIC2). JSON columns hold
-- arrays/objects. Every id below is prefixed with its track id, so ids never collide with the practice pack.

CREATE TABLE pack_meta (
    key TEXT NOT NULL PRIMARY KEY,
    value TEXT NOT NULL
);

-- One track. jlpt_min/jlpt_max: easiest and hardest JLPT level the content targets (5 = N5). ilr: "" or the
-- ILR range the track targets ("2-3"). counts: JSON {"words":n,"kanji":n,"scenarios":n,…}.
CREATE TABLE track (
    id TEXT NOT NULL PRIMARY KEY,
    ord INTEGER NOT NULL,
    title_en TEXT NOT NULL,
    title_ja TEXT NOT NULL,
    description TEXT NOT NULL,
    inspired_by TEXT NOT NULL,
    jlpt_min INTEGER NOT NULL,
    jlpt_max INTEGER NOT NULL,
    ilr TEXT NOT NULL,
    counts TEXT NOT NULL,
    license TEXT NOT NULL,
    attribution TEXT NOT NULL,
    source TEXT NOT NULL
);

-- The track's word list in study order. entry_id: JMdict id (validated against the dictionary pack).
-- topic: lesson group ("stream chat"); category: "" or a word-bank category (yojijukugo, kanyouku,
-- onomatopoeia, synonym, antonym, …). accents: Kanjium downstep positions from the dictionary pack ("" = unknown).
CREATE TABLE track_word (
    track_id TEXT NOT NULL,
    ord INTEGER NOT NULL,
    entry_id INTEGER NOT NULL,
    text TEXT NOT NULL,
    reading TEXT NOT NULL,
    gloss TEXT NOT NULL,
    topic TEXT NOT NULL,
    category TEXT NOT NULL,
    jlpt INTEGER,
    accents TEXT NOT NULL,
    note TEXT NOT NULL,
    source TEXT NOT NULL,
    PRIMARY KEY (track_id, ord)
) WITHOUT ROWID;
CREATE INDEX track_word_entry ON track_word(entry_id);

-- Kanji subset. components: JSON string array. breakdown/hint: our own component story and memory hint
-- ("" for derived rows). words: JSON array of JMdict ids from this track that use the kanji.
CREATE TABLE track_kanji (
    track_id TEXT NOT NULL,
    ord INTEGER NOT NULL,
    literal TEXT NOT NULL,
    keyword TEXT NOT NULL,
    components TEXT NOT NULL,
    breakdown TEXT NOT NULL,
    hint TEXT NOT NULL,
    words TEXT NOT NULL,
    source TEXT NOT NULL,
    PRIMARY KEY (track_id, ord)
) WITHOUT ROWID;

-- Role-play scenarios, same columns and meaning as practice.sq `scenario` plus track_id (reuses the
-- role-play screens through app.tsumugi.practice.Scenario). Turn counts vary per scenario.
CREATE TABLE track_scenario (
    id TEXT NOT NULL PRIMARY KEY,
    track_id TEXT NOT NULL,
    ord INTEGER NOT NULL,
    title_en TEXT NOT NULL,
    title_ja TEXT NOT NULL,
    jlpt INTEGER NOT NULL,
    ilr TEXT NOT NULL,
    category TEXT NOT NULL,
    setting TEXT NOT NULL,
    learner_role TEXT NOT NULL,
    partner_role TEXT NOT NULL,
    register TEXT NOT NULL,
    goals TEXT NOT NULL,
    vocabulary TEXT NOT NULL,
    phrases TEXT NOT NULL,
    system_prompt TEXT NOT NULL,
    source TEXT NOT NULL
);
CREATE INDEX track_scenario_track ON track_scenario(track_id, ord);

CREATE TABLE track_scripted_turn (
    scenario_id TEXT NOT NULL,
    ord INTEGER NOT NULL,
    partner_ja TEXT NOT NULL,
    partner_en TEXT NOT NULL,
    intent TEXT NOT NULL,
    sample_answer TEXT NOT NULL,
    PRIMARY KEY (scenario_id, ord)
) WITHOUT ROWID;

-- Two-speaker dialogues, same shape as practice.sq `dialogue` (speakers carry voice hints) plus track_id and ilr.
CREATE TABLE track_dialogue (
    id TEXT NOT NULL PRIMARY KEY,
    track_id TEXT NOT NULL,
    ord INTEGER NOT NULL,
    title TEXT NOT NULL,
    jlpt INTEGER NOT NULL,
    ilr TEXT NOT NULL,
    topic TEXT NOT NULL,
    speakers TEXT NOT NULL,
    source TEXT NOT NULL
);
CREATE INDEX track_dialogue_track ON track_dialogue(track_id, ord);

-- gaps: JSON [{"text":"…","start":n,"end":n,"entryId":123}] (UTF-16 offsets into ja). chunks: JSON string array.
CREATE TABLE track_dialogue_line (
    dialogue_id TEXT NOT NULL,
    ord INTEGER NOT NULL,
    speaker TEXT NOT NULL,
    ja TEXT NOT NULL,
    en TEXT NOT NULL,
    gaps TEXT NOT NULL,
    chunks TEXT NOT NULL,
    PRIMARY KEY (dialogue_id, ord)
) WITHOUT ROWID;

CREATE TABLE track_dialogue_question (
    dialogue_id TEXT NOT NULL,
    ord INTEGER NOT NULL,
    question_en TEXT NOT NULL,
    choices TEXT NOT NULL,
    answer INTEGER NOT NULL,
    PRIMARY KEY (dialogue_id, ord)
) WITHOUT ROWID;

-- Drills. type: keigo | email | fill_in | synonym | usage | meaning | perform. payload: the type's JSON object
-- (formats in docs/CONTENT_PACKS.md; parsed by app.tsumugi.tracks.TrackDrills). topic groups drills in a list.
CREATE TABLE track_drill (
    id TEXT NOT NULL PRIMARY KEY,
    track_id TEXT NOT NULL,
    ord INTEGER NOT NULL,
    type TEXT NOT NULL,
    topic TEXT NOT NULL,
    jlpt INTEGER,
    payload TEXT NOT NULL,
    source TEXT NOT NULL
);
CREATE INDEX track_drill_track ON track_drill(track_id, type, ord);

-- Situations with can-do statements (daily-life admin; any track may have them). can_do: JSON [{"en","ja"}].
CREATE TABLE track_situation (
    id TEXT NOT NULL PRIMARY KEY,
    track_id TEXT NOT NULL,
    ord INTEGER NOT NULL,
    title_en TEXT NOT NULL,
    title_ja TEXT NOT NULL,
    can_do TEXT NOT NULL,
    source TEXT NOT NULL
);

-- Cultural experience tasks (festival, onsen, tea …). payload: JSON {"place","before":[…],"during":[…],
-- "after":[…],"phrases":[…],"etiquette":[…]}.
CREATE TABLE track_task (
    id TEXT NOT NULL PRIMARY KEY,
    track_id TEXT NOT NULL,
    ord INTEGER NOT NULL,
    title_en TEXT NOT NULL,
    title_ja TEXT NOT NULL,
    payload TEXT NOT NULL,
    source TEXT NOT NULL
);

-- ILR-leveled reading passages (fictional; military & liaison). questions: JSON [{"question","choices","answer"}].
CREATE TABLE track_reading (
    id TEXT NOT NULL PRIMARY KEY,
    track_id TEXT NOT NULL,
    ord INTEGER NOT NULL,
    title TEXT NOT NULL,
    ilr TEXT NOT NULL,
    genre TEXT NOT NULL,
    body TEXT NOT NULL,
    questions TEXT NOT NULL,
    source TEXT NOT NULL
);

-- Link-only references (official texts we never copy, e.g. JMSDF/JASDF press releases).
CREATE TABLE track_link (
    track_id TEXT NOT NULL,
    ord INTEGER NOT NULL,
    title TEXT NOT NULL,
    url TEXT NOT NULL,
    note TEXT NOT NULL,
    PRIMARY KEY (track_id, ord)
) WITHOUT ROWID;

metaValue:
SELECT value FROM pack_meta WHERE key = ?;

allTracks:
SELECT * FROM track ORDER BY ord;

trackById:
SELECT * FROM track WHERE id = ?;

words:
SELECT * FROM track_word WHERE track_id = ? ORDER BY ord;

kanji:
SELECT * FROM track_kanji WHERE track_id = ? ORDER BY ord;

scenarios:
SELECT * FROM track_scenario WHERE track_id = ? ORDER BY ord;

scenarioById:
SELECT * FROM track_scenario WHERE id = ?;

scriptedTurns:
SELECT * FROM track_scripted_turn WHERE scenario_id = ? ORDER BY ord;

dialogues:
SELECT * FROM track_dialogue WHERE track_id = ? ORDER BY ord;

dialogueById:
SELECT * FROM track_dialogue WHERE id = ?;

dialogueLines:
SELECT * FROM track_dialogue_line WHERE dialogue_id = ? ORDER BY ord;

dialogueQuestions:
SELECT * FROM track_dialogue_question WHERE dialogue_id = ? ORDER BY ord;

drills:
SELECT * FROM track_drill WHERE track_id = ? ORDER BY ord;

drillsOfType:
SELECT * FROM track_drill WHERE track_id = ? AND type = ? ORDER BY ord;

drillById:
SELECT * FROM track_drill WHERE id = ?;

situations:
SELECT * FROM track_situation WHERE track_id = ? ORDER BY ord;

tasks:
SELECT * FROM track_task WHERE track_id = ? ORDER BY ord;

readings:
SELECT * FROM track_reading WHERE track_id = ? ORDER BY ord;

readingById:
SELECT * FROM track_reading WHERE id = ?;

links:
SELECT * FROM track_link WHERE track_id = ? ORDER BY ord;

-- Inserts (tests; the pack builder writes rows with plain SQL).
insertMeta:
INSERT OR REPLACE INTO pack_meta(key, value) VALUES (?, ?);

insertTrack:
INSERT INTO track VALUES ?;

insertWord:
INSERT INTO track_word VALUES ?;

insertKanji:
INSERT INTO track_kanji VALUES ?;

insertScenario:
INSERT INTO track_scenario VALUES ?;

insertTurn:
INSERT INTO track_scripted_turn VALUES ?;

insertDialogue:
INSERT INTO track_dialogue VALUES ?;

insertLine:
INSERT INTO track_dialogue_line VALUES ?;

insertQuestion:
INSERT INTO track_dialogue_question VALUES ?;

insertDrill:
INSERT INTO track_drill VALUES ?;

insertSituation:
INSERT INTO track_situation VALUES ?;

insertTask:
INSERT INTO track_task VALUES ?;

insertReading:
INSERT INTO track_reading VALUES ?;

insertLink:
INSERT INTO track_link VALUES ?;
