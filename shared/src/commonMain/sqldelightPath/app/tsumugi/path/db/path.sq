-- Read-only kanji path content pack (content/packs/kanji-path.sqlite), built by tools/packs/build_kanji_path.py,
-- which executes the CREATE statements in this file verbatim. 60 levels: radicals → kanji → vocabulary.

CREATE TABLE pack_meta (
    key TEXT NOT NULL PRIMARY KEY,
    value TEXT NOT NULL
);

-- id: "r:<radical>", "k:<kanji>", "v:<jmdict id>". kind: RADICAL | KANJI | VOCAB.
-- keyword: our own English keyword (unique among kanji). meanings/readings: JSON arrays of accepted answers.
-- other_readings: valid readings not taught for this item (answering one shakes instead of failing).
CREATE TABLE path_item (
    id TEXT NOT NULL PRIMARY KEY,
    kind TEXT NOT NULL,
    level INTEGER NOT NULL,
    ord INTEGER NOT NULL,
    text TEXT NOT NULL,
    display TEXT NOT NULL,
    keyword TEXT NOT NULL,
    meanings TEXT NOT NULL,
    readings TEXT NOT NULL,
    other_readings TEXT NOT NULL,
    entry_id INTEGER,
    heisig INTEGER,
    jlpt INTEGER
);
CREATE INDEX path_item_level ON path_item(level, ord);

-- item_id cannot unlock before prereq_id reaches Guru (kanji → its radicals, vocab → its kanji).
CREATE TABLE path_prereq (
    item_id TEXT NOT NULL,
    prereq_id TEXT NOT NULL,
    PRIMARY KEY (item_id, prereq_id)
) WITHOUT ROWID;

metaValue:
SELECT value FROM pack_meta WHERE key = ?;

allItems:
SELECT * FROM path_item ORDER BY level, ord;

itemsAtLevel:
SELECT * FROM path_item WHERE level = ? ORDER BY ord;

itemsByIds:
SELECT * FROM path_item WHERE id IN ?;

allPrereqs:
SELECT * FROM path_prereq;

dependents:
SELECT item_id FROM path_prereq WHERE prereq_id = ?;

insertItem:
INSERT INTO path_item VALUES ?;

insertPrereq:
INSERT INTO path_prereq VALUES ?;

insertMeta:
INSERT OR REPLACE INTO pack_meta(key, value) VALUES (?, ?);
