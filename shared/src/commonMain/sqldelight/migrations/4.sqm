-- User database v4 → v5 (BRIEF_V2 G-03, G-04, G-07, G-12, G-16; DECISIONS D-110…D-118). Everything here is device-local:
-- no sync triggers, not in SyncTables. databases/4.db is the v4 snapshot this migration starts from.

ALTER TABLE reader_doc ADD COLUMN ruby TEXT;

CREATE TABLE reader_question (
    doc_id TEXT NOT NULL PRIMARY KEY,
    level TEXT NOT NULL,
    questions TEXT NOT NULL,
    engine TEXT NOT NULL,
    created_at INTEGER NOT NULL
);

CREATE TABLE recording (
    id TEXT NOT NULL PRIMARY KEY,
    kind TEXT NOT NULL,
    ref TEXT,
    file_name TEXT NOT NULL,
    mime TEXT NOT NULL,
    duration_ms INTEGER NOT NULL,
    size_bytes INTEGER NOT NULL,
    reference_key TEXT,
    origin_device TEXT NOT NULL,
    created_at INTEGER NOT NULL,
    synced_at INTEGER,
    deleted_at INTEGER
);

CREATE INDEX recording_ref ON recording(kind, ref);

CREATE TABLE user_image (
    id TEXT NOT NULL PRIMARY KEY,
    file_name TEXT NOT NULL,
    mime TEXT NOT NULL,
    size_bytes INTEGER NOT NULL,
    origin_device TEXT NOT NULL,
    created_at INTEGER NOT NULL,
    synced_at INTEGER,
    deleted_at INTEGER
);

CREATE TABLE subtitle_cache (
    media_hash TEXT NOT NULL,
    language TEXT NOT NULL,
    srt TEXT NOT NULL,
    engine TEXT NOT NULL,
    created_at INTEGER NOT NULL,
    PRIMARY KEY (media_hash, language)
);

CREATE TABLE media_clip (
    id TEXT NOT NULL PRIMARY KEY,
    item_id TEXT NOT NULL,
    media_id TEXT NOT NULL,
    media_title TEXT NOT NULL,
    start_ms INTEGER NOT NULL,
    end_ms INTEGER NOT NULL,
    text TEXT NOT NULL,
    translation TEXT,
    recording_id TEXT,
    created_at INTEGER NOT NULL
);

CREATE INDEX media_clip_media ON media_clip(media_id);

CREATE TABLE podcast_feed (
    id TEXT NOT NULL PRIMARY KEY,
    url TEXT NOT NULL UNIQUE,
    title TEXT NOT NULL,
    author TEXT,
    image_url TEXT,
    added_at INTEGER NOT NULL,
    last_fetched_at INTEGER
);

CREATE TABLE podcast_episode (
    id TEXT NOT NULL PRIMARY KEY,
    feed_id TEXT NOT NULL,
    guid TEXT NOT NULL,
    ord INTEGER NOT NULL,
    title TEXT NOT NULL,
    published TEXT,
    audio_url TEXT NOT NULL,
    mime TEXT,
    length_bytes INTEGER,
    duration_ms INTEGER,
    summary TEXT NOT NULL,
    download_state TEXT NOT NULL DEFAULT 'NONE',
    local_file TEXT,
    downloaded_bytes INTEGER NOT NULL DEFAULT 0,
    download_error TEXT,
    media_hash TEXT,
    position_ms INTEGER NOT NULL DEFAULT 0,
    added_at INTEGER NOT NULL
);

CREATE INDEX podcast_episode_feed ON podcast_episode(feed_id, ord);

CREATE TABLE content_review_verdict (
    kind TEXT NOT NULL,
    item_id TEXT NOT NULL,
    verdict TEXT NOT NULL,
    notes TEXT NOT NULL,
    edits TEXT NOT NULL,
    decided_at INTEGER NOT NULL,
    PRIMARY KEY (kind, item_id)
);
