-- User database v9 -> v10 (BRIEF_V2 6.12-6.14; DECISIONS D-270, D-274, D-278): translation attempts (the translation
-- skill line; union + one-way tombstone), writing-studio drafts and solo reading-circle sessions (both LWW with a
-- deleted flag). databases/9.db is the schema snapshot this migration starts from: generated from the merged v9 schema
-- (8.sqm, the pitch-test and game-score tables) before these tables were added. Written as 8.sqm on its branch and
-- renumbered to 9 when merged after the other Phase 13 migration.

CREATE TABLE translation_attempt (
    id TEXT NOT NULL PRIMARY KEY,
    passage_id TEXT NOT NULL,
    direction TEXT NOT NULL,
    genre TEXT NOT NULL,
    level TEXT NOT NULL,
    mode TEXT NOT NULL,
    source_text TEXT NOT NULL,
    attempt_text TEXT NOT NULL,
    duration_ms INTEGER NOT NULL,
    time_limit_ms INTEGER,
    grader TEXT NOT NULL,
    accuracy INTEGER NOT NULL,
    completeness INTEGER NOT NULL,
    register INTEGER NOT NULL,
    naturalness INTEGER NOT NULL,
    score INTEGER NOT NULL,
    grade TEXT,
    engine TEXT,
    device_id TEXT NOT NULL,
    created_at INTEGER NOT NULL,
    deleted_at INTEGER
);
CREATE INDEX translation_attempt_created ON translation_attempt(created_at);

CREATE TRIGGER sync_translation_attempt_insert AFTER INSERT ON translation_attempt
WHEN coalesce((SELECT applying FROM sync_state WHERE id = 1), 0) = 0
BEGIN
    INSERT INTO change_log(table_name, row_key, op, created_at) VALUES ('translation_attempt', new.id, 'UPSERT', CAST(strftime('%s', 'now') AS INTEGER) * 1000);
END;
CREATE TRIGGER sync_translation_attempt_tombstone AFTER UPDATE OF deleted_at ON translation_attempt
WHEN coalesce((SELECT applying FROM sync_state WHERE id = 1), 0) = 0 AND old.deleted_at IS NULL AND new.deleted_at IS NOT NULL
BEGIN
    INSERT INTO change_log(table_name, row_key, op, created_at) VALUES ('translation_attempt', new.id, 'UPSERT', CAST(strftime('%s', 'now') AS INTEGER) * 1000);
END;

CREATE TABLE writing_draft (
    id TEXT NOT NULL PRIMARY KEY,
    title TEXT NOT NULL,
    body TEXT NOT NULL,
    task_ref TEXT,
    task_prompt TEXT,
    target_register TEXT,
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL,
    deleted INTEGER NOT NULL DEFAULT 0
);

CREATE TRIGGER sync_writing_draft_insert AFTER INSERT ON writing_draft
WHEN coalesce((SELECT applying FROM sync_state WHERE id = 1), 0) = 0
BEGIN
    INSERT INTO change_log(table_name, row_key, op, created_at) VALUES ('writing_draft', new.id, 'UPSERT', CAST(strftime('%s', 'now') AS INTEGER) * 1000);
END;
CREATE TRIGGER sync_writing_draft_update AFTER UPDATE ON writing_draft
WHEN coalesce((SELECT applying FROM sync_state WHERE id = 1), 0) = 0
BEGIN
    INSERT INTO change_log(table_name, row_key, op, created_at) VALUES ('writing_draft', new.id, 'UPSERT', CAST(strftime('%s', 'now') AS INTEGER) * 1000);
END;

CREATE TABLE circle_session (
    id TEXT NOT NULL PRIMARY KEY,
    text_id TEXT NOT NULL,
    title TEXT NOT NULL,
    sentence_count INTEGER NOT NULL,
    position INTEGER NOT NULL,
    entries TEXT NOT NULL,
    started_at INTEGER NOT NULL,
    finished_at INTEGER,
    updated_at INTEGER NOT NULL,
    deleted INTEGER NOT NULL DEFAULT 0
);

CREATE TRIGGER sync_circle_session_insert AFTER INSERT ON circle_session
WHEN coalesce((SELECT applying FROM sync_state WHERE id = 1), 0) = 0
BEGIN
    INSERT INTO change_log(table_name, row_key, op, created_at) VALUES ('circle_session', new.id, 'UPSERT', CAST(strftime('%s', 'now') AS INTEGER) * 1000);
END;
CREATE TRIGGER sync_circle_session_update AFTER UPDATE ON circle_session
WHEN coalesce((SELECT applying FROM sync_state WHERE id = 1), 0) = 0
BEGIN
    INSERT INTO change_log(table_name, row_key, op, created_at) VALUES ('circle_session', new.id, 'UPSERT', CAST(strftime('%s', 'now') AS INTEGER) * 1000);
END;
