-- User database v1 → v2 (BRIEF_V2 §4: F-04, F-05, F-20, F-27, F-31; DECISIONS D-040).
-- Runs once on devices that already hold a v1 database (the owner's test phone). New installs get the same schema
-- from the CREATE statements in the .sq files; verifySqlDelightMigration checks that both paths agree.

-- F-05: review tombstones; F-20: app-held cards; D-042: push-in-flight flag.
ALTER TABLE review ADD COLUMN deleted_at INTEGER;
ALTER TABLE card ADD COLUMN blocked_reason TEXT;
ALTER TABLE sync_state ADD COLUMN pushing INTEGER NOT NULL DEFAULT 0;

-- F-27: materialized review totals, then a one-time backfill from the existing log.
CREATE TABLE daily_stats (
    slot INTEGER NOT NULL PRIMARY KEY,
    reviews INTEGER NOT NULL DEFAULT 0,
    correct INTEGER NOT NULL DEFAULT 0,
    graded INTEGER NOT NULL DEFAULT 0,
    elapsed_ms INTEGER NOT NULL DEFAULT 0
);

CREATE TRIGGER daily_stats_review_insert AFTER INSERT ON review
WHEN new.rating != 0 AND new.deleted_at IS NULL
BEGIN
    INSERT OR IGNORE INTO daily_stats(slot) VALUES (new.ts / 900000);
    UPDATE daily_stats SET reviews = reviews + 1,
        correct = correct + (CASE WHEN new.correct = 1 THEN 1 ELSE 0 END),
        graded = graded + (CASE WHEN new.correct IS NULL THEN 0 ELSE 1 END),
        elapsed_ms = elapsed_ms + new.elapsed_ms
    WHERE slot = new.ts / 900000;
END;

CREATE TRIGGER daily_stats_review_tombstone AFTER UPDATE OF deleted_at ON review
WHEN old.rating != 0 AND old.deleted_at IS NULL AND new.deleted_at IS NOT NULL
BEGIN
    UPDATE daily_stats SET reviews = reviews - 1,
        correct = correct - (CASE WHEN old.correct = 1 THEN 1 ELSE 0 END),
        graded = graded - (CASE WHEN old.correct IS NULL THEN 0 ELSE 1 END),
        elapsed_ms = elapsed_ms - old.elapsed_ms
    WHERE slot = old.ts / 900000;
END;

CREATE TRIGGER daily_stats_review_delete AFTER DELETE ON review
WHEN old.rating != 0 AND old.deleted_at IS NULL
BEGIN
    UPDATE daily_stats SET reviews = reviews - 1,
        correct = correct - (CASE WHEN old.correct = 1 THEN 1 ELSE 0 END),
        graded = graded - (CASE WHEN old.correct IS NULL THEN 0 ELSE 1 END),
        elapsed_ms = elapsed_ms - old.elapsed_ms
    WHERE slot = old.ts / 900000;
END;

INSERT INTO daily_stats(slot, reviews, correct, graded, elapsed_ms)
SELECT ts / 900000, COUNT(*), SUM(CASE WHEN correct = 1 THEN 1 ELSE 0 END),
    SUM(CASE WHEN correct IS NULL THEN 0 ELSE 1 END), SUM(elapsed_ms)
FROM review WHERE rating != 0 GROUP BY ts / 900000;

-- F-04: persisted path progress and unlocks.
CREATE TABLE path_progress (
    track TEXT NOT NULL PRIMARY KEY,
    generation INTEGER NOT NULL DEFAULT 0,
    passed_level INTEGER NOT NULL,
    passed_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL
);

CREATE TABLE path_unlock (
    item_id TEXT NOT NULL PRIMARY KEY,
    source TEXT NOT NULL,
    unlocked_at INTEGER NOT NULL
);

-- F-31: per-device settings (never synced).
CREATE TABLE device_setting (
    key TEXT NOT NULL PRIMARY KEY,
    value TEXT NOT NULL
);

-- Sync triggers for the new synced rows.
CREATE TRIGGER sync_review_tombstone AFTER UPDATE OF deleted_at ON review
WHEN coalesce((SELECT applying FROM sync_state WHERE id = 1), 0) = 0 AND old.deleted_at IS NULL AND new.deleted_at IS NOT NULL
BEGIN
    INSERT INTO change_log(table_name, row_key, op, created_at) VALUES ('review', new.id, 'UPSERT', CAST(strftime('%s', 'now') AS INTEGER) * 1000);
END;

CREATE TRIGGER sync_path_progress_insert AFTER INSERT ON path_progress
WHEN coalesce((SELECT applying FROM sync_state WHERE id = 1), 0) = 0
BEGIN
    INSERT INTO change_log(table_name, row_key, op, created_at) VALUES ('path_progress', new.track, 'UPSERT', CAST(strftime('%s', 'now') AS INTEGER) * 1000);
END;

CREATE TRIGGER sync_path_progress_update AFTER UPDATE ON path_progress
WHEN coalesce((SELECT applying FROM sync_state WHERE id = 1), 0) = 0
BEGIN
    INSERT INTO change_log(table_name, row_key, op, created_at) VALUES ('path_progress', new.track, 'UPSERT', CAST(strftime('%s', 'now') AS INTEGER) * 1000);
END;

CREATE TRIGGER sync_path_unlock_insert AFTER INSERT ON path_unlock
WHEN coalesce((SELECT applying FROM sync_state WHERE id = 1), 0) = 0
BEGIN
    INSERT INTO change_log(table_name, row_key, op, created_at) VALUES ('path_unlock', new.item_id, 'UPSERT', CAST(strftime('%s', 'now') AS INTEGER) * 1000);
END;

-- One-time data moves. The old synced level floor becomes the persisted passed level (it syncs from here on).
INSERT INTO path_progress(track, generation, passed_level, passed_at, updated_at)
SELECT 'kanji-path', 0, CAST(value AS INTEGER) - 1, updated_at, updated_at FROM setting
WHERE key = 'path.levelFloor' AND CAST(value AS INTEGER) > 1;

-- Device-local keys move out of the synced table. The local delete is not propagated (applying = 1): each
-- device moves its own values when it upgrades. The manual-unlock JSON array is split into path_unlock rows
-- by PathService on first use (no JSON1 on Android 8–10).
INSERT OR IGNORE INTO device_setting(key, value)
SELECT key, value FROM setting WHERE key IN (
    'ai.llm', 'ai.local_model', 'ai.endpoint_url', 'ai.endpoint_model', 'ai.stt', 'ai.local_stt_model',
    'ai.stt_endpoint_url', 'ai.tts', 'ai.voicevox_url', 'ai.voicevox_speaker'
);
UPDATE sync_state SET applying = 1 WHERE id = 1;
DELETE FROM setting WHERE key IN (
    'ai.llm', 'ai.local_model', 'ai.endpoint_url', 'ai.endpoint_model', 'ai.stt', 'ai.local_stt_model',
    'ai.stt_endpoint_url', 'ai.tts', 'ai.voicevox_url', 'ai.voicevox_speaker'
);
UPDATE sync_state SET applying = 0 WHERE id = 1;
