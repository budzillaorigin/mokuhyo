-- User database v8 -> v9 (BRIEF_V2 §6.7, §6.9; DECISIONS D-284, D-286): pitch-accent test answers and mini-game scores,
-- both insert-only and synced by union. databases/8.db is the schema snapshot this migration starts from (generated
-- before this change). Another Phase 13 branch may also add an 8.sqm; the coordinator renumbers one of them at merge.

CREATE TABLE pitch_test_result (
    id TEXT NOT NULL PRIMARY KEY,
    item_id TEXT NOT NULL,
    mode TEXT NOT NULL,
    expected TEXT NOT NULL,
    answer TEXT NOT NULL,
    correct INTEGER NOT NULL,
    pattern TEXT NOT NULL,
    mora_count INTEGER NOT NULL,
    level INTEGER NOT NULL,
    response_ms INTEGER NOT NULL,
    answered_at INTEGER NOT NULL,
    device_id TEXT NOT NULL
);
CREATE INDEX pitch_test_result_time ON pitch_test_result(answered_at);

CREATE TRIGGER sync_pitch_test_result_insert AFTER INSERT ON pitch_test_result
WHEN coalesce((SELECT applying FROM sync_state WHERE id = 1), 0) = 0
BEGIN
    INSERT INTO change_log(table_name, row_key, op, created_at) VALUES ('pitch_test_result', new.id, 'UPSERT', CAST(strftime('%s', 'now') AS INTEGER) * 1000);
END;

CREATE TABLE game_score (
    id TEXT NOT NULL PRIMARY KEY,
    game TEXT NOT NULL,
    score INTEGER NOT NULL,
    correct INTEGER NOT NULL,
    total INTEGER NOT NULL,
    best_streak INTEGER NOT NULL,
    duration_ms INTEGER NOT NULL,
    day TEXT NOT NULL,
    played_at INTEGER NOT NULL,
    device_id TEXT NOT NULL
);
CREATE INDEX game_score_day ON game_score(day);

CREATE TRIGGER sync_game_score_insert AFTER INSERT ON game_score
WHEN coalesce((SELECT applying FROM sync_state WHERE id = 1), 0) = 0
BEGIN
    INSERT INTO change_log(table_name, row_key, op, created_at) VALUES ('game_score', new.id, 'UPSERT', CAST(strftime('%s', 'now') AS INTEGER) * 1000);
END;
