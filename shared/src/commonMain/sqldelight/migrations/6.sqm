-- User database v5 -> v6 (BRIEF_V2 6.2, 6.3, 6.4, 6.11; DECISIONS D-160...D-169): the immersion log (synced by union plus
-- a tombstone), reader annotations (synced last-writer-wins plus a tombstone), and the device-local sentence bank,
-- lyrics, document extras and per-document vocabulary. databases/5.db is the v5 snapshot this migration starts from.

CREATE TABLE immersion_session (
    id TEXT NOT NULL PRIMARY KEY,
    day TEXT NOT NULL,
    source TEXT NOT NULL,
    mode TEXT NOT NULL,
    started_at INTEGER NOT NULL,
    duration_s INTEGER NOT NULL,
    ref TEXT,
    title TEXT,
    device_id TEXT NOT NULL,
    created_at INTEGER NOT NULL,
    deleted_at INTEGER
);
CREATE INDEX immersion_session_day ON immersion_session(day);

CREATE TRIGGER sync_immersion_session_insert AFTER INSERT ON immersion_session
WHEN coalesce((SELECT applying FROM sync_state WHERE id = 1), 0) = 0
BEGIN
    INSERT INTO change_log(table_name, row_key, op, created_at) VALUES ('immersion_session', new.id, 'UPSERT', CAST(strftime('%s', 'now') AS INTEGER) * 1000);
END;
CREATE TRIGGER sync_immersion_session_tombstone AFTER UPDATE OF deleted_at ON immersion_session
WHEN coalesce((SELECT applying FROM sync_state WHERE id = 1), 0) = 0 AND old.deleted_at IS NULL AND new.deleted_at IS NOT NULL
BEGIN
    INSERT INTO change_log(table_name, row_key, op, created_at) VALUES ('immersion_session', new.id, 'UPSERT', CAST(strftime('%s', 'now') AS INTEGER) * 1000);
END;

CREATE TABLE media_index (
    media_id TEXT NOT NULL PRIMARY KEY,
    title TEXT NOT NULL,
    kind TEXT NOT NULL,
    locator TEXT,
    cue_source TEXT NOT NULL,
    cue_count INTEGER NOT NULL,
    indexed_at INTEGER NOT NULL
);

CREATE TABLE media_cue (
    media_id TEXT NOT NULL,
    idx INTEGER NOT NULL,
    start_ms INTEGER NOT NULL,
    end_ms INTEGER NOT NULL,
    text TEXT NOT NULL,
    tokens TEXT NOT NULL,
    PRIMARY KEY (media_id, idx)
) WITHOUT ROWID;

CREATE TABLE media_cue_token (
    token TEXT NOT NULL,
    media_id TEXT NOT NULL,
    idx INTEGER NOT NULL,
    PRIMARY KEY (token, media_id, idx)
) WITHOUT ROWID;

CREATE TABLE lyrics_song (
    id TEXT NOT NULL PRIMARY KEY,
    title TEXT NOT NULL,
    artist TEXT,
    audio_locator TEXT NOT NULL,
    media_hash TEXT,
    timing TEXT NOT NULL,
    lines TEXT NOT NULL,
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL
);

CREATE TABLE reader_annotation (
    id TEXT NOT NULL PRIMARY KEY,
    doc_key TEXT NOT NULL,
    kind TEXT NOT NULL,
    start_offset INTEGER NOT NULL,
    end_offset INTEGER NOT NULL,
    quote TEXT NOT NULL,
    note TEXT NOT NULL DEFAULT '',
    color TEXT,
    grammar_id TEXT,
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL,
    deleted INTEGER NOT NULL DEFAULT 0
);
CREATE INDEX reader_annotation_doc ON reader_annotation(doc_key);

CREATE TRIGGER sync_reader_annotation_insert AFTER INSERT ON reader_annotation
WHEN coalesce((SELECT applying FROM sync_state WHERE id = 1), 0) = 0
BEGIN
    INSERT INTO change_log(table_name, row_key, op, created_at) VALUES ('reader_annotation', new.id, 'UPSERT', CAST(strftime('%s', 'now') AS INTEGER) * 1000);
END;
CREATE TRIGGER sync_reader_annotation_update AFTER UPDATE ON reader_annotation
WHEN coalesce((SELECT applying FROM sync_state WHERE id = 1), 0) = 0
BEGIN
    INSERT INTO change_log(table_name, row_key, op, created_at) VALUES ('reader_annotation', new.id, 'UPSERT', CAST(strftime('%s', 'now') AS INTEGER) * 1000);
END;

CREATE TABLE reader_doc_meta (
    doc_id TEXT NOT NULL PRIMARY KEY,
    doc_key TEXT NOT NULL,
    page_images TEXT
);

CREATE TABLE reader_doc_vocab (
    doc_id TEXT NOT NULL,
    ref TEXT NOT NULL,
    text TEXT NOT NULL,
    reading TEXT NOT NULL,
    gloss TEXT NOT NULL,
    entry_id INTEGER,
    sentence TEXT NOT NULL,
    word_start INTEGER NOT NULL,
    word_end INTEGER NOT NULL,
    lookups INTEGER NOT NULL DEFAULT 1,
    first_at INTEGER NOT NULL,
    last_at INTEGER NOT NULL,
    removed INTEGER NOT NULL DEFAULT 0,
    PRIMARY KEY (doc_id, ref)
) WITHOUT ROWID;
