-- User database v3 → v4 (BRIEF_V2 G-01, G-02, G-11; DECISIONS D-100, D-101, D-106): persisted conversations,
-- finished Today blocks and streak freezes. All three are insert-only and sync by union.
CREATE TABLE conversation (
    id TEXT NOT NULL PRIMARY KEY,
    mode TEXT NOT NULL,
    scenario_id TEXT,
    started_at INTEGER NOT NULL,
    ended_at INTEGER NOT NULL,
    level TEXT NOT NULL,
    turns TEXT NOT NULL,
    level_estimate TEXT,
    errors TEXT NOT NULL,
    engine TEXT,
    device_id TEXT NOT NULL
);
CREATE INDEX conversation_ended ON conversation(ended_at);

CREATE TABLE today_block_done (
    day TEXT NOT NULL,
    block TEXT NOT NULL,
    completed_at INTEGER NOT NULL,
    PRIMARY KEY (day, block)
) WITHOUT ROWID;

CREATE TABLE streak_freeze (
    day TEXT NOT NULL PRIMARY KEY,
    reason TEXT NOT NULL,
    created_at INTEGER NOT NULL
);

CREATE TRIGGER sync_conversation_insert AFTER INSERT ON conversation
WHEN coalesce((SELECT applying FROM sync_state WHERE id = 1), 0) = 0
BEGIN
    INSERT INTO change_log(table_name, row_key, op, created_at) VALUES ('conversation', new.id, 'UPSERT', CAST(strftime('%s', 'now') AS INTEGER) * 1000);
END;

CREATE TRIGGER sync_today_block_done_insert AFTER INSERT ON today_block_done
WHEN coalesce((SELECT applying FROM sync_state WHERE id = 1), 0) = 0
BEGIN
    INSERT INTO change_log(table_name, row_key, op, created_at)
    VALUES ('today_block_done', new.day || char(31) || new.block, 'UPSERT', CAST(strftime('%s', 'now') AS INTEGER) * 1000);
END;

CREATE TRIGGER sync_streak_freeze_insert AFTER INSERT ON streak_freeze
WHEN coalesce((SELECT applying FROM sync_state WHERE id = 1), 0) = 0
BEGIN
    INSERT INTO change_log(table_name, row_key, op, created_at) VALUES ('streak_freeze', new.day, 'UPSERT', CAST(strftime('%s', 'now') AS INTEGER) * 1000);
END;
