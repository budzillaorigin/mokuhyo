-- Reader documents and feeds (BRIEF §5.8). Device-local: fetched articles are cached on this device only and
-- never sent to the sync server.

-- source_kind: PASTE | URL | RSS | AOZORA | EPUB | PACK. progress = character offset the reader last showed.
-- jlpt_estimate: 5..1 (0 = harder than N1), null until analyzed. ilr_estimate: "0+", "1", "1+", "2", "2+", "3".
CREATE TABLE reader_doc (
    id TEXT NOT NULL PRIMARY KEY,
    title TEXT NOT NULL,
    source_kind TEXT NOT NULL,
    source_url TEXT,
    author TEXT,
    body TEXT NOT NULL,
    imported_at INTEGER NOT NULL,
    jlpt_estimate INTEGER,
    ilr_estimate TEXT,
    known_ratio REAL,
    progress INTEGER NOT NULL DEFAULT 0,
    is_user_content INTEGER NOT NULL DEFAULT 1
);
CREATE INDEX reader_doc_imported ON reader_doc(imported_at);
CREATE INDEX reader_doc_source ON reader_doc(source_url);

CREATE TABLE reader_feed (
    id TEXT NOT NULL PRIMARY KEY,
    url TEXT NOT NULL UNIQUE,
    title TEXT NOT NULL,
    added_at INTEGER NOT NULL,
    last_fetched_at INTEGER
);

insertDoc:
INSERT OR REPLACE INTO reader_doc(id, title, source_kind, source_url, author, body, imported_at, jlpt_estimate, ilr_estimate, known_ratio, progress, is_user_content)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

docById:
SELECT * FROM reader_doc WHERE id = ?;

docBySourceUrl:
SELECT * FROM reader_doc WHERE source_url = ? LIMIT 1;

docList:
SELECT id, title, source_kind, source_url, author, imported_at, jlpt_estimate, ilr_estimate, known_ratio, progress,
    length(body) AS length
FROM reader_doc ORDER BY imported_at DESC;

deleteDoc:
DELETE FROM reader_doc WHERE id = ?;

updateProgress:
UPDATE reader_doc SET progress = ? WHERE id = ?;

updateAnalysis:
UPDATE reader_doc SET jlpt_estimate = ?, ilr_estimate = ?, known_ratio = ? WHERE id = ?;

insertFeed:
INSERT OR IGNORE INTO reader_feed(id, url, title, added_at, last_fetched_at) VALUES (?, ?, ?, ?, NULL);

feeds:
SELECT * FROM reader_feed ORDER BY title;

feedByUrl:
SELECT * FROM reader_feed WHERE url = ?;

renameFeed:
UPDATE reader_feed SET title = ? WHERE id = ?;

markFeedFetched:
UPDATE reader_feed SET last_fetched_at = ? WHERE id = ?;

deleteFeed:
DELETE FROM reader_feed WHERE id = ?;
