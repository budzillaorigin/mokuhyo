-- Mini-games (BRIEF_V2 §6.9; DECISIONS D-286). One row per finished round of Reflex or Atom. Insert-only and synced by
-- union: a score is a fact, and the weekly challenge sums this week's rows on every device.
-- game: REFLEX | ATOM. day: the local ISO date the round finished on. duration_ms: how long the round ran.
CREATE TABLE game_score (
    id TEXT NOT NULL PRIMARY KEY,
    game TEXT NOT NULL,
    score INTEGER NOT NULL,
    correct INTEGER NOT NULL,
    total INTEGER NOT NULL,
    best_streak INTEGER NOT NULL,
    duration_ms INTEGER NOT NULL,
    day TEXT NOT NULL,
    played_at INTEGER NOT NULL,
    device_id TEXT NOT NULL
);
CREATE INDEX game_score_day ON game_score(day);

CREATE TRIGGER sync_game_score_insert AFTER INSERT ON game_score
WHEN coalesce((SELECT applying FROM sync_state WHERE id = 1), 0) = 0
BEGIN
    INSERT INTO change_log(table_name, row_key, op, created_at) VALUES ('game_score', new.id, 'UPSERT', CAST(strftime('%s', 'now') AS INTEGER) * 1000);
END;

insertGameScore:
INSERT OR IGNORE INTO game_score(id, game, score, correct, total, best_streak, duration_ms, day, played_at, device_id)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

gameScoresBetween:
SELECT * FROM game_score WHERE day >= ? AND day <= ? ORDER BY played_at, id;

bestGameScore:
SELECT coalesce(max(score), 0) FROM game_score WHERE game = ?;

recentGameScores:
SELECT * FROM game_score WHERE game = ? ORDER BY played_at DESC, id DESC LIMIT ?;
