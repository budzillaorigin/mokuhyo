-- Conversations (BRIEF §5.1 Conversation, §5.10 free talk; BRIEF_V2 G-02; DECISIONS D-101).

-- One finished conversation: free talk (mode FREE_TALK, no scenario) or a scenario role-play (SCENARIO).
-- Written once when the conversation ends, then immutable: syncs by union like exam attempts. Recordings never
-- sync, so turns carry no audio paths.
-- level: the JLPT label the partner spoke at ("N4"). turns: JSON [{"role":"learner"|"partner","ja":"…","en":"…",
-- "corrections":{…CorrectSentence output…}|null}]. level_estimate: JSON ConversationLevel for this conversation,
-- null when it was too short to judge. errors: JSON [{"type":"PARTICLE","original":"…","replacement":"…",
-- "reason":"…"}] classified from correct_sentence edits. engine: the model that wrote the partner lines (shown with
-- the AI-generated badge), null for scripted turns.
CREATE TABLE conversation (
    id TEXT NOT NULL PRIMARY KEY,
    mode TEXT NOT NULL,
    scenario_id TEXT,
    started_at INTEGER NOT NULL,
    ended_at INTEGER NOT NULL,
    level TEXT NOT NULL,
    turns TEXT NOT NULL,
    level_estimate TEXT,
    errors TEXT NOT NULL,
    engine TEXT,
    device_id TEXT NOT NULL
);
CREATE INDEX conversation_ended ON conversation(ended_at);

insertConversation:
INSERT OR IGNORE INTO conversation(id, mode, scenario_id, started_at, ended_at, level, turns, level_estimate, errors, engine, device_id)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

conversationById:
SELECT * FROM conversation WHERE id = ?;

conversationsSince:
SELECT * FROM conversation WHERE ended_at >= ? ORDER BY ended_at DESC;

recentConversations:
SELECT * FROM conversation ORDER BY ended_at DESC LIMIT ?;
