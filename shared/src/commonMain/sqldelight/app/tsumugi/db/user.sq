-- User-level data: settings, word lists, sessions, integrations.

-- Synced settings (last-writer-wins by updated_at). Device-only state lives in app_meta.
CREATE TABLE setting (
    key TEXT NOT NULL PRIMARY KEY,
    value TEXT NOT NULL,
    updated_at INTEGER NOT NULL
);

CREATE TABLE word_list (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL,
    deleted INTEGER NOT NULL DEFAULT 0
);

-- ref = "jmdict:<id>" when the word resolved to a dictionary entry, otherwise "text:<headword>|<reading>".
-- text/reading/gloss are a snapshot so lists survive without the dictionary (imports, exports).
CREATE TABLE word_list_entry (
    list_id TEXT NOT NULL,
    ref TEXT NOT NULL,
    text TEXT NOT NULL,
    reading TEXT NOT NULL,
    gloss TEXT NOT NULL,
    added_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL,
    deleted INTEGER NOT NULL DEFAULT 0,
    PRIMARY KEY (list_id, ref)
) WITHOUT ROWID;

-- kind: TODAY | REVIEW | LESSON | CONVERSATION | EXAM | WRITING | LISTENING | READING
CREATE TABLE session (
    id TEXT NOT NULL PRIMARY KEY,
    kind TEXT NOT NULL,
    started_at INTEGER NOT NULL,
    ended_at INTEGER,
    stats TEXT NOT NULL DEFAULT '{}'
);
CREATE INDEX session_started ON session(started_at);

-- kind: WANIKANI | BUNPRO | NOTION | LLM_ENDPOINT | VOICEVOX | SYNC. Secrets are in the keychain, never here.
CREATE TABLE integration (
    kind TEXT NOT NULL PRIMARY KEY,
    config TEXT NOT NULL DEFAULT '{}',
    last_sync_at INTEGER,
    cursor TEXT
);

-- Settings ----------------------------------------------------------------------------------------------

settingValue:
SELECT value FROM setting WHERE key = ?;

putSetting:
INSERT OR REPLACE INTO setting(key, value, updated_at) VALUES (?, ?, ?);

allSettings:
SELECT * FROM setting;

-- Word lists --------------------------------------------------------------------------------------------

insertList:
INSERT INTO word_list(id, name, created_at, updated_at) VALUES (?, ?, ?, ?);

renameList:
UPDATE word_list SET name = ?, updated_at = ? WHERE id = ?;

deleteList:
UPDATE word_list SET deleted = 1, updated_at = ? WHERE id = ?;

lists:
SELECT word_list.*, (SELECT COUNT(*) FROM word_list_entry e WHERE e.list_id = word_list.id AND e.deleted = 0) AS size
FROM word_list WHERE deleted = 0 ORDER BY name;

-- Keeps the original added_at when re-adding a word that was already in the list.
putListEntry:
INSERT OR REPLACE INTO word_list_entry(list_id, ref, text, reading, gloss, added_at, updated_at, deleted)
VALUES (:listId, :ref, :text, :reading, :gloss,
    coalesce((SELECT added_at FROM word_list_entry WHERE list_id = :listId AND ref = :ref), :now), :now, 0);

removeListEntry:
UPDATE word_list_entry SET deleted = 1, updated_at = ? WHERE list_id = ? AND ref = ?;

listEntries:
SELECT * FROM word_list_entry WHERE list_id = ? AND deleted = 0 ORDER BY added_at, ref;

listsContaining:
SELECT list_id FROM word_list_entry WHERE ref = ? AND deleted = 0;

-- Sessions ----------------------------------------------------------------------------------------------

insertSession:
INSERT INTO session(id, kind, started_at, ended_at, stats) VALUES (?, ?, ?, ?, ?);

finishSession:
UPDATE session SET ended_at = ?, stats = ? WHERE id = ?;

sessionsSince:
SELECT * FROM session WHERE started_at >= ? ORDER BY started_at;

-- Integrations ------------------------------------------------------------------------------------------

integration:
SELECT * FROM integration WHERE kind = ?;

putIntegration:
INSERT OR REPLACE INTO integration(kind, config, last_sync_at, cursor) VALUES (?, ?, ?, ?);

removeIntegration:
DELETE FROM integration WHERE kind = ?;

-- Path progress (CLAUDE.md rule 11, DECISIONS D-041) ---------------------------------------------------------

-- The highest path level the learner has passed, per track ("kanji-path"). A persisted fact: it only rises
-- (raisePathProgress), except through an explicit, confirmed reset that bumps generation. Synced with the MAX
-- rule: the higher (generation, passed_level, updated_at, device) wins, so two devices converge on the higher
-- level, and a reset beats every level recorded before it.
CREATE TABLE path_progress (
    track TEXT NOT NULL PRIMARY KEY,
    generation INTEGER NOT NULL DEFAULT 0,
    passed_level INTEGER NOT NULL,
    passed_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL
);

-- Path items the learner may take a lesson for, once unlocked: by hand ('manual') or because their prerequisites
-- reached Guru ('auto'). Insert-only and synced by set union, so an unlock never disappears.
CREATE TABLE path_unlock (
    item_id TEXT NOT NULL PRIMARY KEY,
    source TEXT NOT NULL,
    unlocked_at INTEGER NOT NULL
);

pathProgress:
SELECT * FROM path_progress WHERE track = ?;

insertPathProgressIfAbsent:
INSERT OR IGNORE INTO path_progress(track, generation, passed_level, passed_at, updated_at) VALUES (?, 0, 0, 0, 0);

raisePathProgress:
UPDATE path_progress SET passed_level = :level, passed_at = :at, updated_at = :at
WHERE track = :track AND passed_level < :level;

resetPathProgress:
UPDATE path_progress SET generation = generation + 1, passed_level = :level, passed_at = :at, updated_at = :at
WHERE track = :track;

insertUnlock:
INSERT OR IGNORE INTO path_unlock(item_id, source, unlocked_at) VALUES (?, ?, ?);

allUnlocks:
SELECT * FROM path_unlock;

-- Device settings (CLAUDE.md rule 16, DECISIONS D-047) -----------------------------------------------------------

-- Per-device configuration that must never sync: AI engine and model choice, endpoint URLs, audio engine.
-- There is deliberately no sync trigger on this table.
CREATE TABLE device_setting (
    key TEXT NOT NULL PRIMARY KEY,
    value TEXT NOT NULL
);

deviceSetting:
SELECT value FROM device_setting WHERE key = ?;

putDeviceSetting:
INSERT OR REPLACE INTO device_setting(key, value) VALUES (?, ?);

removeDeviceSetting:
DELETE FROM device_setting WHERE key = ?;
