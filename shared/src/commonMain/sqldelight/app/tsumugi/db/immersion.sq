-- Immersion pipeline (BRIEF_V2 §6.2, §6.3, §6.11; DECISIONS D-160…D-169).
-- immersion_session syncs (union + one-way tombstone). Everything else here is device-local: the media and the
-- audio files it indexes live on this device only.

-- §6.11 immersion log. One row per finished stretch of immersion. day: the local ISO date it started on.
-- source: READER | MEDIA | PODCAST | DIALOGUE | MANUAL. mode: ACTIVE | PASSIVE. ref: the document / media id it
-- came from (null for manual entries). Written once; a delete sets deleted_at, which reaches every device.
CREATE TABLE immersion_session (
    id TEXT NOT NULL PRIMARY KEY,
    day TEXT NOT NULL,
    source TEXT NOT NULL,
    mode TEXT NOT NULL,
    started_at INTEGER NOT NULL,
    duration_s INTEGER NOT NULL,
    ref TEXT,
    title TEXT,
    device_id TEXT NOT NULL,
    created_at INTEGER NOT NULL,
    deleted_at INTEGER
);
CREATE INDEX immersion_session_day ON immersion_session(day);

CREATE TRIGGER sync_immersion_session_insert AFTER INSERT ON immersion_session
WHEN coalesce((SELECT applying FROM sync_state WHERE id = 1), 0) = 0
BEGIN
    INSERT INTO change_log(table_name, row_key, op, created_at) VALUES ('immersion_session', new.id, 'UPSERT', CAST(strftime('%s', 'now') AS INTEGER) * 1000);
END;
CREATE TRIGGER sync_immersion_session_tombstone AFTER UPDATE OF deleted_at ON immersion_session
WHEN coalesce((SELECT applying FROM sync_state WHERE id = 1), 0) = 0 AND old.deleted_at IS NULL AND new.deleted_at IS NOT NULL
BEGIN
    INSERT INTO change_log(table_name, row_key, op, created_at) VALUES ('immersion_session', new.id, 'UPSERT', CAST(strftime('%s', 'now') AS INTEGER) * 1000);
END;

-- §6.2 sentence bank: the learner's own media with subtitles. kind: VIDEO | AUDIO. locator: the platform's handle
-- for the file (path, content URI, bookmark) so a hit can be played and clipped. cue_source: FILE | GENERATED.
CREATE TABLE media_index (
    media_id TEXT NOT NULL PRIMARY KEY,
    title TEXT NOT NULL,
    kind TEXT NOT NULL,
    locator TEXT,
    cue_source TEXT NOT NULL,
    cue_count INTEGER NOT NULL,
    indexed_at INTEGER NOT NULL
);

-- One subtitle cue. tokens: JSON array of the lattice tokenizer's words [{s, e, l, id}] (offsets in text, lemma,
-- JMdict id), so a hit can highlight the word it matched.
CREATE TABLE media_cue (
    media_id TEXT NOT NULL,
    idx INTEGER NOT NULL,
    start_ms INTEGER NOT NULL,
    end_ms INTEGER NOT NULL,
    text TEXT NOT NULL,
    tokens TEXT NOT NULL,
    PRIMARY KEY (media_id, idx)
) WITHOUT ROWID;

-- Token index (D-160): "e:<JMdict id>" and "w:<lemma>" per cue, one row per distinct token.
CREATE TABLE media_cue_token (
    token TEXT NOT NULL,
    media_id TEXT NOT NULL,
    idx INTEGER NOT NULL,
    PRIMARY KEY (token, media_id, idx)
) WITHOUT ROWID;

-- §6.3 lyrics. audio_locator: the learner's own audio file. timing: LRC_WORDS | LRC_LINES | ALIGNED | NONE.
-- lines: JSON array of LyricLine (text, times, word timings, translation, cloze picks). Device-local (D-163).
CREATE TABLE lyrics_song (
    id TEXT NOT NULL PRIMARY KEY,
    title TEXT NOT NULL,
    artist TEXT,
    audio_locator TEXT NOT NULL,
    media_hash TEXT,
    timing TEXT NOT NULL,
    lines TEXT NOT NULL,
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL
);

-- Immersion log ------------------------------------------------------------------------------------------------

insertImmersion:
INSERT OR IGNORE INTO immersion_session(id, day, source, mode, started_at, duration_s, ref, title, device_id, created_at, deleted_at)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, NULL);

immersionBetween:
SELECT * FROM immersion_session WHERE day >= ? AND day <= ? AND deleted_at IS NULL ORDER BY started_at;

immersionById:
SELECT * FROM immersion_session WHERE id = ?;

immersionTotalSeconds:
SELECT coalesce(sum(duration_s), 0) AS total FROM immersion_session WHERE deleted_at IS NULL;

tombstoneImmersion:
UPDATE immersion_session SET deleted_at = ? WHERE id = ? AND deleted_at IS NULL;

-- Sentence bank ------------------------------------------------------------------------------------------------

putMediaIndex:
INSERT OR REPLACE INTO media_index(media_id, title, kind, locator, cue_source, cue_count, indexed_at) VALUES (?, ?, ?, ?, ?, ?, ?);

mediaIndexById:
SELECT * FROM media_index WHERE media_id = ?;

mediaIndexAll:
SELECT * FROM media_index ORDER BY title;

mediaIndexByIds:
SELECT * FROM media_index WHERE media_id IN ?;

deleteMediaIndex:
DELETE FROM media_index WHERE media_id = ?;

insertMediaCue:
INSERT OR REPLACE INTO media_cue(media_id, idx, start_ms, end_ms, text, tokens) VALUES (?, ?, ?, ?, ?, ?);

deleteMediaCues:
DELETE FROM media_cue WHERE media_id = ?;

insertCueToken:
INSERT OR IGNORE INTO media_cue_token(token, media_id, idx) VALUES (?, ?, ?);

deleteCueTokens:
DELETE FROM media_cue_token WHERE media_id = ?;

cueRefsForToken:
SELECT media_id, idx FROM media_cue_token WHERE token = ?;

mediaCueAt:
SELECT * FROM media_cue WHERE media_id = ? AND idx = ?;

mediaCuesOf:
SELECT * FROM media_cue WHERE media_id = ? ORDER BY idx;

-- Substring fallback for queries the tokenizer can't split (names, partial words).
mediaCuesContaining:
SELECT * FROM media_cue WHERE instr(text, ?) > 0 ORDER BY length(text) LIMIT ?;

-- Lyrics -------------------------------------------------------------------------------------------------------

putSong:
INSERT OR REPLACE INTO lyrics_song(id, title, artist, audio_locator, media_hash, timing, lines, created_at, updated_at)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

songById:
SELECT * FROM lyrics_song WHERE id = ?;

songList:
SELECT id, title, artist, timing, updated_at FROM lyrics_song ORDER BY title;

setSongLines:
UPDATE lyrics_song SET lines = ?, timing = ?, updated_at = ? WHERE id = ?;

deleteSong:
DELETE FROM lyrics_song WHERE id = ?;
