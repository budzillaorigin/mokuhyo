-- Sync bookkeeping (docs/SYNC_PROTOCOL.md). Triggers record dirty-row markers for the synced tables; the
-- sync engine serializes the rows' current state when it pushes. While remote changes are being applied,
-- sync_state.applying = 1 silences the triggers so applied changes don't echo back.
-- Composite keys are joined with U+001F. No JSON1 functions and no UPSERT syntax (Android 8–10 SQLite).

CREATE TABLE change_log (
    seq INTEGER PRIMARY KEY AUTOINCREMENT,
    table_name TEXT NOT NULL,
    row_key TEXT NOT NULL,
    op TEXT NOT NULL,
    created_at INTEGER NOT NULL,
    synced INTEGER NOT NULL DEFAULT 0
);
CREATE INDEX change_log_unsynced ON change_log(synced, seq);

CREATE TABLE sync_state (
    id INTEGER NOT NULL PRIMARY KEY CHECK (id = 1),
    applying INTEGER NOT NULL DEFAULT 0,
    -- 1 while a push is between reading rows and marking them synced: rows may be on the wire, so an undo must
    -- tombstone rather than physically delete (DECISIONS D-042).
    pushing INTEGER NOT NULL DEFAULT 0
);
INSERT OR IGNORE INTO sync_state(id, applying) VALUES (1, 0);

-- Which (updatedAt, deviceId) the local copy of a row came from, for last-writer-wins tie-breaks.
CREATE TABLE sync_row_version (
    table_name TEXT NOT NULL,
    row_key TEXT NOT NULL,
    updated_at INTEGER NOT NULL,
    device_id TEXT NOT NULL,
    PRIMARY KEY (table_name, row_key)
) WITHOUT ROWID;

-- item ----------------------------------------------------------------------------------------------------
CREATE TRIGGER sync_item_insert AFTER INSERT ON item
WHEN coalesce((SELECT applying FROM sync_state WHERE id = 1), 0) = 0
BEGIN
    INSERT INTO change_log(table_name, row_key, op, created_at) VALUES ('item', new.id, 'UPSERT', CAST(strftime('%s', 'now') AS INTEGER) * 1000);
END;
CREATE TRIGGER sync_item_update AFTER UPDATE ON item
WHEN coalesce((SELECT applying FROM sync_state WHERE id = 1), 0) = 0
BEGIN
    INSERT INTO change_log(table_name, row_key, op, created_at) VALUES ('item', new.id, 'UPSERT', CAST(strftime('%s', 'now') AS INTEGER) * 1000);
END;
CREATE TRIGGER sync_item_delete AFTER DELETE ON item
WHEN coalesce((SELECT applying FROM sync_state WHERE id = 1), 0) = 0
BEGIN
    INSERT INTO change_log(table_name, row_key, op, created_at) VALUES ('item', old.id, 'DELETE', CAST(strftime('%s', 'now') AS INTEGER) * 1000);
END;

-- item_relation (insert-only union) ----------------------------------------------------------------------
CREATE TRIGGER sync_item_relation_insert AFTER INSERT ON item_relation
WHEN coalesce((SELECT applying FROM sync_state WHERE id = 1), 0) = 0
BEGIN
    INSERT INTO change_log(table_name, row_key, op, created_at)
    VALUES ('item_relation', new.parent_id || char(31) || new.child_id || char(31) || new.kind, 'UPSERT', CAST(strftime('%s', 'now') AS INTEGER) * 1000);
END;

-- review (append-only; union + tombstone) ----------------------------------------------------------------
CREATE TRIGGER sync_review_insert AFTER INSERT ON review
WHEN coalesce((SELECT applying FROM sync_state WHERE id = 1), 0) = 0
BEGIN
    INSERT INTO change_log(table_name, row_key, op, created_at) VALUES ('review', new.id, 'UPSERT', CAST(strftime('%s', 'now') AS INTEGER) * 1000);
END;
-- The one permitted update: an undo tombstones the row, and the tombstone must reach every device.
CREATE TRIGGER sync_review_tombstone AFTER UPDATE OF deleted_at ON review
WHEN coalesce((SELECT applying FROM sync_state WHERE id = 1), 0) = 0 AND old.deleted_at IS NULL AND new.deleted_at IS NOT NULL
BEGIN
    INSERT INTO change_log(table_name, row_key, op, created_at) VALUES ('review', new.id, 'UPSERT', CAST(strftime('%s', 'now') AS INTEGER) * 1000);
END;

