END;

-- card: only the user-set suspended flag syncs ("card_flags"); FSRS state is recomputed from reviews ------------
CREATE TRIGGER sync_card_flags AFTER UPDATE OF suspended ON card
WHEN coalesce((SELECT applying FROM sync_state WHERE id = 1), 0) = 0 AND old.suspended != new.suspended
BEGIN
    INSERT INTO change_log(table_name, row_key, op, created_at) VALUES ('card_flags', new.id, 'UPSERT', CAST(strftime('%s', 'now') AS INTEGER) * 1000);
END;

-- Queries -------------------------------------------------------------------------------------------------

setApplying:
UPDATE sync_state SET applying = ? WHERE id = 1;

unsyncedMarkers:
SELECT * FROM change_log WHERE synced = 0 AND seq <= :upTo ORDER BY seq;

maxUnsyncedSeq:
SELECT max(seq) AS max_seq FROM change_log WHERE synced = 0;

markSyncedUpTo:
UPDATE change_log SET synced = 1 WHERE synced = 0 AND seq <= ?;

purgeSynced:
DELETE FROM change_log WHERE synced = 1;

unsyncedCount:
SELECT count(*) FROM change_log WHERE synced = 0;

hasUnsyncedMarker:
SELECT count(*) FROM change_log WHERE synced = 0 AND table_name = ? AND row_key = ?;

rowVersion:
SELECT * FROM sync_row_version WHERE table_name = ? AND row_key = ?;

putRowVersion:
INSERT OR REPLACE INTO sync_row_version(table_name, row_key, updated_at, device_id) VALUES (?, ?, ?, ?);

setPushing:
UPDATE sync_state SET pushing = ? WHERE id = 1;

isPushing:
SELECT pushing FROM sync_state WHERE id = 1;

-- Drops the insert marker of an append-only row that is physically deleted before it was ever pushed.
deleteUnsyncedMarkers:
DELETE FROM change_log WHERE synced = 0 AND table_name = ? AND row_key = ?;
