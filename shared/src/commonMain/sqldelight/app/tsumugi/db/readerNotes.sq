-- Reader annotations, page images and per-document vocabulary (BRIEF_V2 §6.4; DECISIONS D-164…D-166).

-- An annotation on a reader document. doc_key identifies the text across devices (reader documents themselves
-- don't sync): "url:<source url>" or "sha256:<hash of the NFC body>" (D-164). start_offset/end_offset are character
-- offsets in the body; quote is the covered text, used to re-anchor when the body changed.
-- kind: BOX | HIGHLIGHT | NOTE | GRAMMAR. grammar_id: the grammar point a GRAMMAR span marks (optional).
-- Synced last-writer-wins by updated_at; a delete is deleted = 1 (tombstone row).
CREATE TABLE reader_annotation (
    id TEXT NOT NULL PRIMARY KEY,
    doc_key TEXT NOT NULL,
    kind TEXT NOT NULL,
    start_offset INTEGER NOT NULL,
    end_offset INTEGER NOT NULL,
    quote TEXT NOT NULL,
    note TEXT NOT NULL DEFAULT '',
    color TEXT,
    grammar_id TEXT,
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL,
    deleted INTEGER NOT NULL DEFAULT 0
);
CREATE INDEX reader_annotation_doc ON reader_annotation(doc_key);

CREATE TRIGGER sync_reader_annotation_insert AFTER INSERT ON reader_annotation
WHEN coalesce((SELECT applying FROM sync_state WHERE id = 1), 0) = 0
BEGIN
    INSERT INTO change_log(table_name, row_key, op, created_at) VALUES ('reader_annotation', new.id, 'UPSERT', CAST(strftime('%s', 'now') AS INTEGER) * 1000);
END;
CREATE TRIGGER sync_reader_annotation_update AFTER UPDATE ON reader_annotation
WHEN coalesce((SELECT applying FROM sync_state WHERE id = 1), 0) = 0
BEGIN
    INSERT INTO change_log(table_name, row_key, op, created_at) VALUES ('reader_annotation', new.id, 'UPSERT', CAST(strftime('%s', 'now') AS INTEGER) * 1000);
END;

-- Per-document extras (device-local, like the document). page_images: JSON [{imageId, start, end}] for documents
-- imported from screenshots; the picture is kept as the page image (ImageStore id).
CREATE TABLE reader_doc_meta (
    doc_id TEXT NOT NULL PRIMARY KEY,
    doc_key TEXT NOT NULL,
    page_images TEXT
);

-- Auto vocabulary list: every word looked up in a document (device-local). ref: "jmdict:<id>" or
-- "text:<word>|<reading>". sentence plus word_start/word_end: the word inside the sentence it was looked up in.
CREATE TABLE reader_doc_vocab (
    doc_id TEXT NOT NULL,
    ref TEXT NOT NULL,
    text TEXT NOT NULL,
    reading TEXT NOT NULL,
    gloss TEXT NOT NULL,
    entry_id INTEGER,
    sentence TEXT NOT NULL,
    word_start INTEGER NOT NULL,
    word_end INTEGER NOT NULL,
    lookups INTEGER NOT NULL DEFAULT 1,
    first_at INTEGER NOT NULL,
    last_at INTEGER NOT NULL,
    removed INTEGER NOT NULL DEFAULT 0,
    PRIMARY KEY (doc_id, ref)
) WITHOUT ROWID;

-- Annotations --------------------------------------------------------------------------------------------------

putAnnotation:
INSERT OR REPLACE INTO reader_annotation(id, doc_key, kind, start_offset, end_offset, quote, note, color, grammar_id, created_at, updated_at, deleted)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, 0);

annotationById:
SELECT * FROM reader_annotation WHERE id = ?;

annotationsForDoc:
SELECT * FROM reader_annotation WHERE doc_key = ? AND deleted = 0 ORDER BY start_offset, created_at;

tombstoneAnnotation:
UPDATE reader_annotation SET deleted = 1, updated_at = ? WHERE id = ? AND deleted = 0;

-- Document meta ------------------------------------------------------------------------------------------------

docMeta:
SELECT * FROM reader_doc_meta WHERE doc_id = ?;

putDocMeta:
INSERT OR REPLACE INTO reader_doc_meta(doc_id, doc_key, page_images) VALUES (?, ?, ?);

deleteDocMeta:
DELETE FROM reader_doc_meta WHERE doc_id = ?;

-- Document vocabulary ------------------------------------------------------------------------------------------

insertDocVocab:
INSERT OR IGNORE INTO reader_doc_vocab(doc_id, ref, text, reading, gloss, entry_id, sentence, word_start, word_end, lookups, first_at, last_at, removed)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, 0, ?, ?, 0);

-- A repeat lookup counts, refreshes the sentence and brings a removed word back.
bumpDocVocab:
UPDATE reader_doc_vocab SET lookups = lookups + 1, last_at = ?, sentence = ?, word_start = ?, word_end = ?, removed = 0
WHERE doc_id = ? AND ref = ?;

docVocab:
SELECT * FROM reader_doc_vocab WHERE doc_id = ? AND removed = 0 ORDER BY first_at, ref;

removeDocVocab:
UPDATE reader_doc_vocab SET removed = 1 WHERE doc_id = ? AND ref = ?;

deleteDocVocab:
DELETE FROM reader_doc_vocab WHERE doc_id = ?;
