-- Learning items, their cards, and the immutable review log (BRIEF §5.1).
-- Times are epoch milliseconds. Ids of pack-derived rows are deterministic ("k:語", "jmdict:1358280",
-- card "<itemId>#<DIRECTION>") so two devices that create the same row independently converge on sync.

-- kind: RADICAL | KANJI | VOCAB | GRAMMAR | SENTENCE | LISTENING | WRITING | MINIMAL_PAIR | CUSTOM
-- source: pack | wanikani | anki | user | llm | verified
-- meanings / accepted_readings: JSON string arrays. context: free-form JSON (mined sentence, anki fields…).
CREATE TABLE item (
    id TEXT NOT NULL PRIMARY KEY,
    kind TEXT NOT NULL,
    level INTEGER,
    jlpt INTEGER,
    ilr TEXT,
    primary_text TEXT NOT NULL,
    reading TEXT,
    meanings TEXT NOT NULL,
    accepted_readings TEXT NOT NULL DEFAULT '[]',
    source TEXT NOT NULL,
    pack_id TEXT,
    ref_id TEXT,
    context TEXT,
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL,
    deleted INTEGER NOT NULL DEFAULT 0
);
CREATE INDEX item_kind_level ON item(kind, level);
CREATE INDEX item_ref ON item(source, ref_id);

-- kind: COMPONENT | USES_KANJI | GRAMMAR_EXAMPLE | SIMILAR | CONFUSED_WITH
CREATE TABLE item_relation (
    parent_id TEXT NOT NULL,
    child_id TEXT NOT NULL,
    kind TEXT NOT NULL,
    PRIMARY KEY (parent_id, child_id, kind)
) WITHOUT ROWID;
CREATE INDEX item_relation_child ON item_relation(child_id);

-- direction: RECOGNITION | RECALL | MEANING | READING | WRITING | LISTENING | CLOZE | PRODUCTION
-- state: NEW | LEARNING | REVIEW | RELEARNING. FSRS state is a cache: it can always be recomputed by
-- replaying the card's reviews (that is how sync converges; BRIEF §8.2).
CREATE TABLE card (
    id TEXT NOT NULL PRIMARY KEY,
    item_id TEXT NOT NULL,
    direction TEXT NOT NULL,
    state TEXT NOT NULL,
    step INTEGER,
    stability REAL,
    difficulty REAL,
    due INTEGER NOT NULL,
    last_review INTEGER,
    reps INTEGER NOT NULL DEFAULT 0,
    lapses INTEGER NOT NULL DEFAULT 0,
    suspended INTEGER NOT NULL DEFAULT 0,
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL
);
CREATE INDEX card_due ON card(suspended, state, due);
CREATE INDEX card_item ON card(item_id);

-- Immutable, append-only. Never updated or deleted (sync merges reviews by set union).
CREATE TABLE review (
    id TEXT NOT NULL PRIMARY KEY,
    card_id TEXT NOT NULL,
    ts INTEGER NOT NULL,
    rating INTEGER NOT NULL,
    elapsed_ms INTEGER NOT NULL,
    answer_text TEXT,
    correct INTEGER,
    device_id TEXT NOT NULL,
    source TEXT NOT NULL DEFAULT 'app'
);
CREATE INDEX review_card ON review(card_id, ts);
CREATE INDEX review_ts ON review(ts);

-- The NihongoShark "myStory" concept: the user's own mnemonic, synonyms and media for an item.
CREATE TABLE note (
    item_id TEXT NOT NULL PRIMARY KEY,
    my_story TEXT NOT NULL DEFAULT '',
    synonyms TEXT NOT NULL DEFAULT '[]',
    tags TEXT NOT NULL DEFAULT '[]',
    mnemonic_image_path TEXT,
    user_audio_path TEXT,
    updated_at INTEGER NOT NULL
);

-- Items -------------------------------------------------------------------------------------------------

-- No UPSERT syntax: Android 8-10 ship SQLite < 3.24. Callers run insertItemIfAbsent + updateItem in a transaction.
insertItemIfAbsent:
INSERT OR IGNORE INTO item(id, kind, level, jlpt, ilr, primary_text, reading, meanings, accepted_readings, source, pack_id, ref_id, context, created_at, updated_at, deleted)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, 0);

updateItem:
UPDATE item SET kind = ?, level = ?, jlpt = ?, ilr = ?, primary_text = ?, reading = ?, meanings = ?,
    accepted_readings = ?, source = ?, pack_id = ?, ref_id = ?, context = ?, updated_at = ?, deleted = 0
WHERE id = ?;

itemById:
SELECT * FROM item WHERE id = ?;

itemsByIds:
SELECT * FROM item WHERE id IN ? AND deleted = 0;

itemsByKind:
SELECT * FROM item WHERE kind = ? AND deleted = 0 ORDER BY level, created_at;

itemsBySourceRef:
SELECT * FROM item WHERE source = ? AND ref_id IN ? AND deleted = 0;

itemCount:
SELECT kind, COUNT(*) FROM item WHERE deleted = 0 GROUP BY kind;

deleteItem:
UPDATE item SET deleted = 1, updated_at = ? WHERE id = ?;

insertRelation:
INSERT OR IGNORE INTO item_relation(parent_id, child_id, kind) VALUES (?, ?, ?);

childrenOf:
SELECT child_id FROM item_relation WHERE parent_id = ? AND kind = ?;

parentsOf:
SELECT parent_id FROM item_relation WHERE child_id = ? AND kind = ?;

-- Cards -------------------------------------------------------------------------------------------------

insertCardIfAbsent:
INSERT OR IGNORE INTO card(id, item_id, direction, state, step, stability, difficulty, due, last_review, reps, lapses, suspended, created_at, updated_at)
VALUES (?, ?, ?, 'NEW', NULL, NULL, NULL, ?, NULL, 0, 0, 0, ?, ?);

updateCardState:
UPDATE card SET state = ?, step = ?, stability = ?, difficulty = ?, due = ?, last_review = ?, reps = ?, lapses = ?, updated_at = ?
WHERE id = ?;

setSuspended:
UPDATE card SET suspended = ?, updated_at = ? WHERE id = ?;

cardById:
SELECT * FROM card WHERE id = ?;

cardsForItem:
SELECT * FROM card WHERE item_id = ?;

cardsForItems:
SELECT * FROM card WHERE item_id IN ?;

dueCards:
SELECT card.* FROM card JOIN item ON item.id = card.item_id
WHERE card.suspended = 0 AND card.state != 'NEW' AND card.due <= :now AND item.deleted = 0
ORDER BY card.due
LIMIT :limit;

dueCount:
SELECT COUNT(*) FROM card JOIN item ON item.id = card.item_id
WHERE card.suspended = 0 AND card.state != 'NEW' AND card.due <= :now AND item.deleted = 0;

dueCountByKind:
SELECT item.kind, COUNT(*) FROM card JOIN item ON item.id = card.item_id
WHERE card.suspended = 0 AND card.state != 'NEW' AND card.due <= :now AND item.deleted = 0
GROUP BY item.kind;

newCards:
SELECT card.* FROM card JOIN item ON item.id = card.item_id
WHERE card.suspended = 0 AND card.state = 'NEW' AND item.deleted = 0
ORDER BY coalesce(item.level, 999), card.created_at
LIMIT :limit;

forecast:
SELECT card.due FROM card JOIN item ON item.id = card.item_id
WHERE card.suspended = 0 AND card.state != 'NEW' AND card.due > :from AND card.due <= :to AND item.deleted = 0;

allStartedCards:
SELECT card.*, item.kind AS item_kind, item.level AS item_level FROM card JOIN item ON item.id = card.item_id
WHERE card.state != 'NEW' AND item.deleted = 0;

leeches:
SELECT card.* FROM card JOIN item ON item.id = card.item_id
WHERE card.lapses >= :threshold AND card.suspended = 0 AND item.deleted = 0
ORDER BY card.lapses DESC;

-- Reviews -----------------------------------------------------------------------------------------------

insertReview:
INSERT OR IGNORE INTO review(id, card_id, ts, rating, elapsed_ms, answer_text, correct, device_id, source)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

reviewsForCard:
SELECT * FROM review WHERE card_id = ? ORDER BY ts, id;

reviewsSince:
SELECT review.*, item.kind AS item_kind FROM review
JOIN card ON card.id = review.card_id JOIN item ON item.id = card.item_id
WHERE review.ts >= ? ORDER BY review.ts;

allReviews:
SELECT * FROM review ORDER BY card_id, ts, id;

reviewCount:
SELECT COUNT(*) FROM review;

reviewDays:
SELECT DISTINCT (ts + :offsetMs) / 86400000 AS day FROM review ORDER BY day DESC;

deleteReview:
DELETE FROM review WHERE id = ?;

-- Notes -------------------------------------------------------------------------------------------------

noteFor:
SELECT * FROM note WHERE item_id = ?;

putNote:
INSERT OR REPLACE INTO note(item_id, my_story, synonyms, tags, mnemonic_image_path, user_audio_path, updated_at)
VALUES (?, ?, ?, ?, ?, ?, ?);
