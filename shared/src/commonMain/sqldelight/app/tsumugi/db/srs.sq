-- Learning items, their cards, and the immutable review log (BRIEF §5.1).
-- Times are epoch milliseconds. Ids of pack-derived rows are deterministic ("k:語", "jmdict:1358280",
-- card "<itemId>#<DIRECTION>") so two devices that create the same row independently converge on sync.

-- kind: RADICAL | KANJI | VOCAB | GRAMMAR | SENTENCE | LISTENING | WRITING | MINIMAL_PAIR | CUSTOM
-- source: pack | wanikani | anki | user | llm | verified
-- meanings / accepted_readings: JSON string arrays. context: free-form JSON (mined sentence, anki fields…).
CREATE TABLE item (
    id TEXT NOT NULL PRIMARY KEY,
    kind TEXT NOT NULL,
    level INTEGER,
    jlpt INTEGER,
    ilr TEXT,
    primary_text TEXT NOT NULL,
    reading TEXT,
    meanings TEXT NOT NULL,
    accepted_readings TEXT NOT NULL DEFAULT '[]',
    source TEXT NOT NULL,
    pack_id TEXT,
    ref_id TEXT,
    context TEXT,
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL,
    deleted INTEGER NOT NULL DEFAULT 0
);
CREATE INDEX item_kind_level ON item(kind, level);
CREATE INDEX item_ref ON item(source, ref_id);

-- kind: COMPONENT | USES_KANJI | GRAMMAR_EXAMPLE | SIMILAR | CONFUSED_WITH
CREATE TABLE item_relation (
    parent_id TEXT NOT NULL,
    child_id TEXT NOT NULL,
    kind TEXT NOT NULL,
    PRIMARY KEY (parent_id, child_id, kind)
) WITHOUT ROWID;
CREATE INDEX item_relation_child ON item_relation(child_id);

-- direction: RECOGNITION | RECALL | MEANING | READING | WRITING | LISTENING | CLOZE | PRODUCTION
-- state: NEW | LEARNING | REVIEW | RELEARNING. FSRS state is a cache: it can always be recomputed by
-- replaying the card's reviews (that is how sync converges; BRIEF §8.2).
CREATE TABLE card (
    id TEXT NOT NULL PRIMARY KEY,
    item_id TEXT NOT NULL,
    direction TEXT NOT NULL,
    state TEXT NOT NULL,
    step INTEGER,
    stability REAL,
    difficulty REAL,
    due INTEGER NOT NULL,
    last_review INTEGER,
    reps INTEGER NOT NULL DEFAULT 0,
    lapses INTEGER NOT NULL DEFAULT 0,
    suspended INTEGER NOT NULL DEFAULT 0,
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL,
    -- Device-local, never synced: why the app itself holds this card out of reviews ('NO_EXAMPLES' for a grammar
    -- point whose pack has no example sentence yet). NULL = available. Unlike suspended (the learner's choice,
    -- synced) it is recomputed from the installed packs at pack load (DECISIONS D-045).
    blocked_reason TEXT
);
CREATE INDEX card_due ON card(suspended, state, due);
CREATE INDEX card_item ON card(item_id);

-- Append-only. The only update ever made is setting deleted_at (a tombstone: undo, CLAUDE.md rule 12); a row is
-- physically deleted only when it was never pushed (DECISIONS D-042). Sync merges reviews by set union plus
-- tombstone propagation. Every reader of the log filters deleted_at IS NULL.
CREATE TABLE review (
    id TEXT NOT NULL PRIMARY KEY,
    card_id TEXT NOT NULL,
    ts INTEGER NOT NULL,
    rating INTEGER NOT NULL,
    elapsed_ms INTEGER NOT NULL,
    answer_text TEXT,
    correct INTEGER,
    device_id TEXT NOT NULL,
    source TEXT NOT NULL DEFAULT 'app',
    deleted_at INTEGER
);
CREATE INDEX review_card ON review(card_id, ts);
CREATE INDEX review_ts ON review(ts);

-- Derived review totals per UTC quarter-hour (slot = ts / 900000), kept by the triggers below on every insert,
-- tombstone and delete of a graded review, including rows applied by sync. Quarter-hour slots map exactly onto
-- local calendar days in every real time zone, so stats bucket by day at read time (DECISIONS D-046).
-- Lesson introductions (rating 0) are not counted. Not synced: each device derives it from its own log.
CREATE TABLE daily_stats (
    slot INTEGER NOT NULL PRIMARY KEY,
    reviews INTEGER NOT NULL DEFAULT 0,
    correct INTEGER NOT NULL DEFAULT 0,
    graded INTEGER NOT NULL DEFAULT 0,
    elapsed_ms INTEGER NOT NULL DEFAULT 0
);

CREATE TRIGGER daily_stats_review_insert AFTER INSERT ON review
WHEN new.rating != 0 AND new.deleted_at IS NULL
BEGIN
    INSERT OR IGNORE INTO daily_stats(slot) VALUES (new.ts / 900000);
    UPDATE daily_stats SET reviews = reviews + 1,
        correct = correct + (CASE WHEN new.correct = 1 THEN 1 ELSE 0 END),
        graded = graded + (CASE WHEN new.correct IS NULL THEN 0 ELSE 1 END),
        elapsed_ms = elapsed_ms + new.elapsed_ms
    WHERE slot = new.ts / 900000;
END;

CREATE TRIGGER daily_stats_review_tombstone AFTER UPDATE OF deleted_at ON review
WHEN old.rating != 0 AND old.deleted_at IS NULL AND new.deleted_at IS NOT NULL
BEGIN
    UPDATE daily_stats SET reviews = reviews - 1,
        correct = correct - (CASE WHEN old.correct = 1 THEN 1 ELSE 0 END),
        graded = graded - (CASE WHEN old.correct IS NULL THEN 0 ELSE 1 END),
        elapsed_ms = elapsed_ms - old.elapsed_ms
    WHERE slot = old.ts / 900000;
END;

CREATE TRIGGER daily_stats_review_delete AFTER DELETE ON review
WHEN old.rating != 0 AND old.deleted_at IS NULL
BEGIN
    UPDATE daily_stats SET reviews = reviews - 1,
        correct = correct - (CASE WHEN old.correct = 1 THEN 1 ELSE 0 END),
        graded = graded - (CASE WHEN old.correct IS NULL THEN 0 ELSE 1 END),
        elapsed_ms = elapsed_ms - old.elapsed_ms
    WHERE slot = old.ts / 900000;
END;

-- The NihongoShark "myStory" concept: the user's own mnemonic, synonyms and media for an item.
CREATE TABLE note (
    item_id TEXT NOT NULL PRIMARY KEY,
    my_story TEXT NOT NULL DEFAULT '',
    synonyms TEXT NOT NULL DEFAULT '[]',
    tags TEXT NOT NULL DEFAULT '[]',
    mnemonic_image_path TEXT,
    user_audio_path TEXT,
    updated_at INTEGER NOT NULL
);

-- Items -------------------------------------------------------------------------------------------------

-- No UPSERT syntax: Android 8-10 ship SQLite < 3.24. Callers run insertItemIfAbsent + updateItem in a transaction.
insertItemIfAbsent:
INSERT OR IGNORE INTO item(id, kind, level, jlpt, ilr, primary_text, reading, meanings, accepted_readings, source, pack_id, ref_id, context, created_at, updated_at, deleted)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, 0);

updateItem:
UPDATE item SET kind = ?, level = ?, jlpt = ?, ilr = ?, primary_text = ?, reading = ?, meanings = ?,
    accepted_readings = ?, source = ?, pack_id = ?, ref_id = ?, context = ?, updated_at = ?, deleted = 0
WHERE id = ?;

itemById:
SELECT * FROM item WHERE id = ?;

itemsByIds:
SELECT * FROM item WHERE id IN ? AND deleted = 0;

itemsByKind:
SELECT * FROM item WHERE kind = ? AND deleted = 0 ORDER BY level, created_at;

itemsBySourceRef:
SELECT * FROM item WHERE source = ? AND ref_id IN ? AND deleted = 0;

allItemIds:
SELECT id FROM item WHERE deleted = 0 ORDER BY created_at;

itemCount:
SELECT kind, COUNT(*) FROM item WHERE deleted = 0 GROUP BY kind;

deleteItem:
UPDATE item SET deleted = 1, updated_at = ? WHERE id = ?;

insertRelation:
INSERT OR IGNORE INTO item_relation(parent_id, child_id, kind) VALUES (?, ?, ?);

childrenOf:
SELECT child_id FROM item_relation WHERE parent_id = ? AND kind = ?;

parentsOf:
SELECT parent_id FROM item_relation WHERE child_id = ? AND kind = ?;

-- Cards -------------------------------------------------------------------------------------------------

insertCardIfAbsent:
INSERT OR IGNORE INTO card(id, item_id, direction, state, step, stability, difficulty, due, last_review, reps, lapses, suspended, created_at, updated_at)
VALUES (?, ?, ?, 'NEW', NULL, NULL, NULL, ?, NULL, 0, 0, 0, ?, ?);

updateCardState:
UPDATE card SET state = ?, step = ?, stability = ?, difficulty = ?, due = ?, last_review = ?, reps = ?, lapses = ?, updated_at = ?
WHERE id = ?;

setSuspended:
UPDATE card SET suspended = ?, updated_at = ? WHERE id = ?;

cardById:
SELECT * FROM card WHERE id = ?;

cardsForItem:
SELECT * FROM card WHERE item_id = ?;

cardsForItems:
SELECT * FROM card WHERE item_id IN ?;

dueCards:
SELECT card.* FROM card JOIN item ON item.id = card.item_id
WHERE card.suspended = 0 AND card.blocked_reason IS NULL AND card.state != 'NEW' AND card.due <= :now AND item.deleted = 0
ORDER BY card.due
LIMIT :limit;

dueCount:
SELECT COUNT(*) FROM card JOIN item ON item.id = card.item_id
WHERE card.suspended = 0 AND card.blocked_reason IS NULL AND card.state != 'NEW' AND card.due <= :now AND item.deleted = 0;

dueCountByKind:
SELECT item.kind, COUNT(*) FROM card JOIN item ON item.id = card.item_id
WHERE card.suspended = 0 AND card.blocked_reason IS NULL AND card.state != 'NEW' AND card.due <= :now AND item.deleted = 0
GROUP BY item.kind;

newCards:
SELECT card.* FROM card JOIN item ON item.id = card.item_id
WHERE card.suspended = 0 AND card.blocked_reason IS NULL AND card.state = 'NEW' AND card.direction != 'GHOST' AND item.deleted = 0
ORDER BY coalesce(item.level, 999), card.created_at
LIMIT :limit;

forecast:
SELECT card.due FROM card JOIN item ON item.id = card.item_id
WHERE card.suspended = 0 AND card.blocked_reason IS NULL AND card.state != 'NEW' AND card.due > :from AND card.due <= :to AND item.deleted = 0;

allStartedCards:
SELECT card.*, item.kind AS item_kind, item.level AS item_level FROM card JOIN item ON item.id = card.item_id
WHERE card.state != 'NEW' AND item.deleted = 0;

-- Stages of a few items (one path level) through the card_item index, instead of a scan of every card.
startedCardsForItems:
SELECT card.* FROM card JOIN item ON item.id = card.item_id
WHERE card.item_id IN :itemIds AND card.state != 'NEW' AND item.deleted = 0;

setBlocked:
UPDATE card SET blocked_reason = :reason WHERE id = :id;

blockedCards:
SELECT * FROM card WHERE blocked_reason IS NOT NULL;

cardsOfKind:
SELECT card.* FROM card JOIN item ON item.id = card.item_id WHERE item.kind = ? AND item.deleted = 0;

deleteCard:
DELETE FROM card WHERE id = ?;

leeches:
SELECT card.* FROM card JOIN item ON item.id = card.item_id
WHERE card.lapses >= :threshold AND card.suspended = 0 AND card.blocked_reason IS NULL AND item.deleted = 0
ORDER BY card.lapses DESC;

-- Reviews -----------------------------------------------------------------------------------------------

insertReview:
INSERT OR IGNORE INTO review(id, card_id, ts, rating, elapsed_ms, answer_text, correct, device_id, source)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

-- Live (not tombstoned) reviews only, everywhere below unless the name says otherwise.
reviewsForCard:
SELECT * FROM review WHERE card_id = ? AND deleted_at IS NULL ORDER BY ts, id;

reviewsSince:
SELECT review.*, item.kind AS item_kind, card.item_id AS item_id, card.direction AS card_direction FROM review
JOIN card ON card.id = review.card_id JOIN item ON item.id = card.item_id
WHERE review.ts >= ? AND review.deleted_at IS NULL ORDER BY review.ts;

allReviews:
SELECT * FROM review WHERE deleted_at IS NULL ORDER BY card_id, ts, id;

-- Every card with any review row, tombstoned ones included (a card whose only review was undone must be rebuilt too).
reviewedCardIds:
SELECT DISTINCT card_id FROM review ORDER BY card_id;

reviewCount:
SELECT COUNT(*) FROM review WHERE deleted_at IS NULL;

reviewDays:
SELECT DISTINCT (ts + :offsetMs) / 86400000 AS day FROM review WHERE deleted_at IS NULL ORDER BY day DESC;

reviewById:
SELECT * FROM review WHERE id = ?;

tombstoneReview:
UPDATE review SET deleted_at = :at WHERE id = :id AND deleted_at IS NULL;

deleteReview:
DELETE FROM review WHERE id = ?;

-- Stats (daily_stats) -----------------------------------------------------------------------------------

statsSlotsSince:
SELECT * FROM daily_stats WHERE slot >= ? AND reviews > 0 ORDER BY slot;

-- Rebuilds daily_stats from the log (1.sqm runs the same backfill once).
clearStats:
DELETE FROM daily_stats;

rebuildStats:
INSERT INTO daily_stats(slot, reviews, correct, graded, elapsed_ms)
SELECT ts / 900000, COUNT(*), SUM(CASE WHEN correct = 1 THEN 1 ELSE 0 END),
    SUM(CASE WHEN correct IS NULL THEN 0 ELSE 1 END), SUM(elapsed_ms)
FROM review WHERE rating != 0 AND deleted_at IS NULL GROUP BY ts / 900000;

-- Notes -------------------------------------------------------------------------------------------------

noteFor:
SELECT * FROM note WHERE item_id = ?;

putNote:
INSERT OR REPLACE INTO note(item_id, my_story, synonyms, tags, mnemonic_image_path, user_audio_path, updated_at)
VALUES (?, ?, ?, ?, ?, ?, ?);
