-- JLPT courses and monolingual mode (BRIEF_V2 §6.6; DECISIONS D-231, D-234). grammar_mastery syncs (LWW on
-- the flag, like known_word); ai_paraphrase is a device-local cache of labeled LLM output and never syncs.

-- The learner's own "I've mastered this" checkbox per grammar point, independent of SRS. Rows are only ever
-- added; unticking sets mastered = 0. Last writer wins by updated_at (docs/SYNC_PROTOCOL.md).
CREATE TABLE grammar_mastery (
    point_id TEXT NOT NULL PRIMARY KEY,
    mastered INTEGER NOT NULL,
    updated_at INTEGER NOT NULL
);

CREATE TRIGGER sync_grammar_mastery_insert AFTER INSERT ON grammar_mastery
WHEN coalesce((SELECT applying FROM sync_state WHERE id = 1), 0) = 0
BEGIN
    INSERT INTO change_log(table_name, row_key, op, created_at) VALUES ('grammar_mastery', new.point_id, 'UPSERT', CAST(strftime('%s', 'now') AS INTEGER) * 1000);
END;
CREATE TRIGGER sync_grammar_mastery_update AFTER UPDATE ON grammar_mastery
WHEN coalesce((SELECT applying FROM sync_state WHERE id = 1), 0) = 0
BEGIN
    INSERT INTO change_log(table_name, row_key, op, created_at) VALUES ('grammar_mastery', new.point_id, 'UPSERT', CAST(strftime('%s', 'now') AS INTEGER) * 1000);
END;

-- Cached AI output that is expensive to regenerate (monolingual word paraphrases, D-234). kind: "word_ja".
-- ref: "jmdict:<id>" or "text:<headword>|<reading>". value: the prompt's JSON output. engine: the model that wrote it
-- (always shown with the "AI-generated" badge). Device-local: no sync trigger, not in SyncTables.
CREATE TABLE ai_paraphrase (
    kind TEXT NOT NULL,
    ref TEXT NOT NULL,
    value TEXT NOT NULL,
    engine TEXT NOT NULL,
    created_at INTEGER NOT NULL,
    PRIMARY KEY (kind, ref)
) WITHOUT ROWID;

allMastery:
SELECT * FROM grammar_mastery;

masteredPointIds:
SELECT point_id FROM grammar_mastery WHERE mastered = 1;

insertMasteryIfAbsent:
INSERT OR IGNORE INTO grammar_mastery(point_id, mastered, updated_at) VALUES (?, ?, ?);

-- Only touches the row (and so only records a sync change) when the flag actually changes.
updateMastery:
UPDATE grammar_mastery SET mastered = :mastered, updated_at = :updatedAt WHERE point_id = :pointId AND mastered != :mastered;

paraphrase:
SELECT * FROM ai_paraphrase WHERE kind = ? AND ref = ?;

putParaphrase:
INSERT OR REPLACE INTO ai_paraphrase(kind, ref, value, engine, created_at) VALUES (?, ?, ?, ?, ?);

deleteParaphrase:
DELETE FROM ai_paraphrase WHERE kind = ? AND ref = ?;
