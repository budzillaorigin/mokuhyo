-- Pitch-accent perception test (BRIEF_V2 §6.7; DECISIONS D-284). One row per answered question. Insert-only and synced
-- by union, like exam attempts: an answer is a fact, and stats are computed from the rows on every device.
-- mode: PATTERN (平板/頭高/中高/尾高) | DOWNSTEP (the mora after which the pitch falls) | WORD_PAIR (which word of a
-- same-kana group was spoken). expected / answer: the pattern name, the downstep number, or the item id.
-- pattern / mora_count: the item's, so stats per pattern and per length need no pack. level: the adaptive level (1–5).
CREATE TABLE pitch_test_result (
    id TEXT NOT NULL PRIMARY KEY,
    item_id TEXT NOT NULL,
    mode TEXT NOT NULL,
    expected TEXT NOT NULL,
    answer TEXT NOT NULL,
    correct INTEGER NOT NULL,
    pattern TEXT NOT NULL,
    mora_count INTEGER NOT NULL,
    level INTEGER NOT NULL,
    response_ms INTEGER NOT NULL,
    answered_at INTEGER NOT NULL,
    device_id TEXT NOT NULL
);
CREATE INDEX pitch_test_result_time ON pitch_test_result(answered_at);

CREATE TRIGGER sync_pitch_test_result_insert AFTER INSERT ON pitch_test_result
WHEN coalesce((SELECT applying FROM sync_state WHERE id = 1), 0) = 0
BEGIN
    INSERT INTO change_log(table_name, row_key, op, created_at) VALUES ('pitch_test_result', new.id, 'UPSERT', CAST(strftime('%s', 'now') AS INTEGER) * 1000);
END;

insertPitchResult:
INSERT OR IGNORE INTO pitch_test_result(id, item_id, mode, expected, answer, correct, pattern, mora_count, level, response_ms, answered_at, device_id)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

pitchResultsSince:
SELECT * FROM pitch_test_result WHERE answered_at >= ? ORDER BY answered_at, id;

recentPitchResults:
SELECT * FROM pitch_test_result ORDER BY answered_at DESC, id DESC LIMIT ?;

pitchResultCount:
SELECT count(*) FROM pitch_test_result;
