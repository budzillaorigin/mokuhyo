-- Today blocks and streak freezes (BRIEF_V2 G-01, G-11; DECISIONS D-100, D-106).

-- A Today block the learner finished on a local day (ISO date "2026-09-18"). block: TodayBlockKind name.
-- Insert-only and synced by union: finishing a block is a fact, and weekly challenges count these rows.
CREATE TABLE today_block_done (
    day TEXT NOT NULL,
    block TEXT NOT NULL,
    completed_at INTEGER NOT NULL,
    PRIMARY KEY (day, block)
) WITHOUT ROWID;

-- A streak freeze: a local day (ISO date) that neither breaks nor extends the streak. reason: FREEZE (spent from
-- the monthly allowance) | VACATION (a day of vacation mode, written when vacation ends). Insert-only, union sync.
CREATE TABLE streak_freeze (
    day TEXT NOT NULL PRIMARY KEY,
    reason TEXT NOT NULL,
    created_at INTEGER NOT NULL
);

markBlockDone:
INSERT OR IGNORE INTO today_block_done(day, block, completed_at) VALUES (?, ?, ?);

blocksDoneOn:
SELECT block FROM today_block_done WHERE day = ?;

blocksDoneBetween:
SELECT * FROM today_block_done WHERE day >= ? AND day <= ? ORDER BY day, block;

insertFreeze:
INSERT OR IGNORE INTO streak_freeze(day, reason, created_at) VALUES (?, ?, ?);

allFreezes:
SELECT * FROM streak_freeze ORDER BY day;
