-- Linguist modules (BRIEF_V2 §6.12–§6.14; DECISIONS D-270…D-279): translation attempts (the skill line on Me), writing
-- studio drafts and solo reading-circle sessions. All three sync; recordings they point at stay device-local unless
-- the learner turns on recordings sync (the recording rows and files are the Phase 10 store).

-- One translation attempt, written once (like an exam attempt). passage_id: a pack passage id (tr-…, tatoeba-…) or
-- "user:<hash>" for imported text; source_text keeps the passage so the attempt stays readable without the pack.
-- direction: JE | EJ. mode: SIGHT (spoken, STT transcript) | WRITTEN. grader: LLM (the grade_translation prompt,
-- always labeled) | SELF (the self-assessment rubric). The four rubric scores are 0–4 each; score = their sum × 100 / 16.
-- grade: the prompt's JSON output (null for SELF). A delete sets deleted_at, which reaches every device (like reviews).
CREATE TABLE translation_attempt (
    id TEXT NOT NULL PRIMARY KEY,
    passage_id TEXT NOT NULL,
    direction TEXT NOT NULL,
    genre TEXT NOT NULL,
    level TEXT NOT NULL,
    mode TEXT NOT NULL,
    source_text TEXT NOT NULL,
    attempt_text TEXT NOT NULL,
    duration_ms INTEGER NOT NULL,
    time_limit_ms INTEGER,
    grader TEXT NOT NULL,
    accuracy INTEGER NOT NULL,
    completeness INTEGER NOT NULL,
    register INTEGER NOT NULL,
    naturalness INTEGER NOT NULL,
    score INTEGER NOT NULL,
    grade TEXT,
    engine TEXT,
    device_id TEXT NOT NULL,
    created_at INTEGER NOT NULL,
    deleted_at INTEGER
);
CREATE INDEX translation_attempt_created ON translation_attempt(created_at);

CREATE TRIGGER sync_translation_attempt_insert AFTER INSERT ON translation_attempt
WHEN coalesce((SELECT applying FROM sync_state WHERE id = 1), 0) = 0
BEGIN
    INSERT INTO change_log(table_name, row_key, op, created_at) VALUES ('translation_attempt', new.id, 'UPSERT', CAST(strftime('%s', 'now') AS INTEGER) * 1000);
END;
CREATE TRIGGER sync_translation_attempt_tombstone AFTER UPDATE OF deleted_at ON translation_attempt
WHEN coalesce((SELECT applying FROM sync_state WHERE id = 1), 0) = 0 AND old.deleted_at IS NULL AND new.deleted_at IS NOT NULL
BEGIN
    INSERT INTO change_log(table_name, row_key, op, created_at) VALUES ('translation_attempt', new.id, 'UPSERT', CAST(strftime('%s', 'now') AS INTEGER) * 1000);
END;

-- A writing-studio draft. task_ref: where an output task came from ("reader:<story id>" for a graded reader's
-- post-reading task), null for free writing; task_prompt: the task text shown above the editor. target_register:
-- CASUAL | POLITE | FORMAL or null. Last writer wins by updated_at; a delete is deleted = 1.
CREATE TABLE writing_draft (
    id TEXT NOT NULL PRIMARY KEY,
    title TEXT NOT NULL,
    body TEXT NOT NULL,
    task_ref TEXT,
    task_prompt TEXT,
    target_register TEXT,
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL,
    deleted INTEGER NOT NULL DEFAULT 0
);

CREATE TRIGGER sync_writing_draft_insert AFTER INSERT ON writing_draft
WHEN coalesce((SELECT applying FROM sync_state WHERE id = 1), 0) = 0
BEGIN
    INSERT INTO change_log(table_name, row_key, op, created_at) VALUES ('writing_draft', new.id, 'UPSERT', CAST(strftime('%s', 'now') AS INTEGER) * 1000);
END;
CREATE TRIGGER sync_writing_draft_update AFTER UPDATE ON writing_draft
WHEN coalesce((SELECT applying FROM sync_state WHERE id = 1), 0) = 0
BEGIN
    INSERT INTO change_log(table_name, row_key, op, created_at) VALUES ('writing_draft', new.id, 'UPSERT', CAST(strftime('%s', 'now') AS INTEGER) * 1000);
END;

-- A solo reading-circle session over one text. text_id: a literature-pack text id or "user:<hash>". entries: JSON
-- [{idx, read, explain, explainRec, doneAt}] per sentence (read / explainRec: recording ids in the device's
-- RecordingStore; explain: the typed English explanation). position: the sentence the learner is on. Last writer
-- wins by updated_at; a delete is deleted = 1.
CREATE TABLE circle_session (
    id TEXT NOT NULL PRIMARY KEY,
    text_id TEXT NOT NULL,
    title TEXT NOT NULL,
    sentence_count INTEGER NOT NULL,
    position INTEGER NOT NULL,
    entries TEXT NOT NULL,
    started_at INTEGER NOT NULL,
    finished_at INTEGER,
    updated_at INTEGER NOT NULL,
    deleted INTEGER NOT NULL DEFAULT 0
);

CREATE TRIGGER sync_circle_session_insert AFTER INSERT ON circle_session
WHEN coalesce((SELECT applying FROM sync_state WHERE id = 1), 0) = 0
BEGIN
    INSERT INTO change_log(table_name, row_key, op, created_at) VALUES ('circle_session', new.id, 'UPSERT', CAST(strftime('%s', 'now') AS INTEGER) * 1000);
END;
CREATE TRIGGER sync_circle_session_update AFTER UPDATE ON circle_session
WHEN coalesce((SELECT applying FROM sync_state WHERE id = 1), 0) = 0
BEGIN
    INSERT INTO change_log(table_name, row_key, op, created_at) VALUES ('circle_session', new.id, 'UPSERT', CAST(strftime('%s', 'now') AS INTEGER) * 1000);
END;

insertAttempt:
INSERT INTO translation_attempt(id, passage_id, direction, genre, level, mode, source_text, attempt_text, duration_ms,
    time_limit_ms, grader, accuracy, completeness, register, naturalness, score, grade, engine, device_id, created_at, deleted_at)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, NULL);

liveAttempts:
SELECT * FROM translation_attempt WHERE deleted_at IS NULL ORDER BY created_at DESC;

attemptsForPassage:
SELECT * FROM translation_attempt WHERE deleted_at IS NULL AND passage_id = ? ORDER BY created_at DESC;

attemptById:
SELECT * FROM translation_attempt WHERE id = ?;

tombstoneAttempt:
UPDATE translation_attempt SET deleted_at = ? WHERE id = ? AND deleted_at IS NULL;

putDraft:
INSERT OR REPLACE INTO writing_draft(id, title, body, task_ref, task_prompt, target_register, created_at, updated_at, deleted)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, 0);

liveDrafts:
SELECT * FROM writing_draft WHERE deleted = 0 ORDER BY updated_at DESC;

draftById:
SELECT * FROM writing_draft WHERE id = ?;

draftForTask:
SELECT * FROM writing_draft WHERE deleted = 0 AND task_ref = ? ORDER BY updated_at DESC LIMIT 1;

deleteDraft:
UPDATE writing_draft SET deleted = 1, updated_at = ? WHERE id = ? AND deleted = 0;

putCircleSession:
INSERT OR REPLACE INTO circle_session(id, text_id, title, sentence_count, position, entries, started_at, finished_at, updated_at, deleted)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, 0);

liveCircleSessions:
SELECT * FROM circle_session WHERE deleted = 0 ORDER BY updated_at DESC;

circleSessionById:
SELECT * FROM circle_session WHERE id = ?;

deleteCircleSession:
UPDATE circle_session SET deleted = 1, updated_at = ? WHERE id = ? AND deleted = 0;
