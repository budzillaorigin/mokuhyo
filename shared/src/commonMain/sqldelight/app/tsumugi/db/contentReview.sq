-- In-app review of AI-drafted content (BRIEF_V2 G-16, DECISIONS D-118). Device-local: verdicts leave the phone
-- only as the exported JSON that tools/items/review.py --ingest applies to the source files.
-- kind: grammar_point | exam_passage | exam_item | dialogue | scenario | reader_passage.
-- verdict: accept | edit | reject. edits: JSON object of field → new value (strings; JSON text for list fields).
CREATE TABLE content_review_verdict (
    kind TEXT NOT NULL,
    item_id TEXT NOT NULL,
    verdict TEXT NOT NULL,
    notes TEXT NOT NULL,
    edits TEXT NOT NULL,
    decided_at INTEGER NOT NULL,
    PRIMARY KEY (kind, item_id)
);

putVerdict:
INSERT OR REPLACE INTO content_review_verdict(kind, item_id, verdict, notes, edits, decided_at) VALUES (?, ?, ?, ?, ?, ?);

verdictFor:
SELECT * FROM content_review_verdict WHERE kind = ? AND item_id = ?;

allVerdicts:
SELECT * FROM content_review_verdict ORDER BY decided_at, kind, item_id;

removeVerdict:
DELETE FROM content_review_verdict WHERE kind = ? AND item_id = ?;

clearVerdicts:
DELETE FROM content_review_verdict;
