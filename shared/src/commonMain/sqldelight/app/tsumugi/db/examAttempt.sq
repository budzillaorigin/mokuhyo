-- Exam attempts (BRIEF §4 ExamAttempt, §5.11) and user-imported item banks.

-- exam: JLPT | DLPT_READING | DLPT_LISTENING | OPI | GRADED_READER. level: "N3", ILR "2" (target band) or "" for
-- OPI/mixed; graded readers use the reader level ("N6" = level 0 … "N1").
-- mode: MOCK | SECTION | TYPE | SLICE_30 | SLICE_60 | FULL | PRACTICE | INTERVIEW | READER.
-- answers: JSON array of {itemId, choice, correct, timeMs}. scoring: JSON of the result (JLPT score groups,
-- ILR estimate, or the OPI rating). summary: one line for lists ("N3 · 112/180 · pass", "ILR 2 (provisional)").
-- Immutable once submitted; syncs by union like reviews.
CREATE TABLE exam_attempt (
    id TEXT NOT NULL PRIMARY KEY,
    exam TEXT NOT NULL,
    level TEXT NOT NULL,
    mode TEXT NOT NULL,
    started_at INTEGER NOT NULL,
    submitted_at INTEGER NOT NULL,
    answers TEXT NOT NULL,
    scoring TEXT NOT NULL,
    summary TEXT NOT NULL,
    device_id TEXT NOT NULL
);
CREATE INDEX exam_attempt_exam ON exam_attempt(exam, submitted_at);

-- Item banks the user imported (docs/CONTENT_PACKS.md format). Device-local.
CREATE TABLE user_exam_bank (
    id TEXT NOT NULL PRIMARY KEY,
    title TEXT NOT NULL,
    json TEXT NOT NULL,
    imported_at INTEGER NOT NULL
);

-- The attempt in progress, if any (F-24, DECISIONS D-080). One row per device at most: state is the JSON
-- ExamProgress (form item/passage ids, answers, position, section deadlines as absolute epoch ms). Device-local:
-- no sync trigger, not in SyncTables. Rewritten after every answer, move and section change; deleted on submit.
CREATE TABLE exam_in_progress (
    id TEXT NOT NULL PRIMARY KEY,
    exam TEXT NOT NULL,
    level TEXT NOT NULL,
    mode TEXT NOT NULL,
    started_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL,
    state TEXT NOT NULL
);

insertAttempt:
INSERT OR IGNORE INTO exam_attempt(id, exam, level, mode, started_at, submitted_at, answers, scoring, summary, device_id)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

attempts:
SELECT * FROM exam_attempt WHERE exam = ? ORDER BY submitted_at DESC LIMIT ?;

-- Graded-reader quizzes share the table (exam = 'GRADED_READER', DECISIONS D-206) but aren't exams.
allAttempts:
SELECT * FROM exam_attempt WHERE exam != 'GRADED_READER' ORDER BY submitted_at DESC LIMIT ?;

attemptById:
SELECT * FROM exam_attempt WHERE id = ?;

putBank:
INSERT OR REPLACE INTO user_exam_bank(id, title, json, imported_at) VALUES (?, ?, ?, ?);

banks:
SELECT * FROM user_exam_bank ORDER BY imported_at;

deleteBank:
DELETE FROM user_exam_bank WHERE id = ?;

putInProgress:
INSERT OR REPLACE INTO exam_in_progress(id, exam, level, mode, started_at, updated_at, state) VALUES (?, ?, ?, ?, ?, ?, ?);

inProgress:
SELECT * FROM exam_in_progress ORDER BY updated_at DESC LIMIT 1;

deleteInProgress:
DELETE FROM exam_in_progress WHERE id = ?;

deleteOtherInProgress:
DELETE FROM exam_in_progress WHERE id != ?;

clearInProgress:
DELETE FROM exam_in_progress;
