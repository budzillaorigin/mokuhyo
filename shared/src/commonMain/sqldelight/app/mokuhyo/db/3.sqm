-- Schema 3 → 4 (Phase 9, N-12): daily stand-to log.
CREATE TABLE stand_to (
    id TEXT NOT NULL PRIMARY KEY,
    learnerId TEXT NOT NULL,
    lang TEXT NOT NULL,
    startedAt INTEGER NOT NULL,
    finishedAt INTEGER NOT NULL,
    recipeJson TEXT NOT NULL,
    resultJson TEXT NOT NULL,
    deleted INTEGER
);
CREATE INDEX stand_to_lang ON stand_to(learnerId, lang, finishedAt);
