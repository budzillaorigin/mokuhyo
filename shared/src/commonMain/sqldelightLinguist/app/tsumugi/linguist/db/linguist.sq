-- The linguist pack, content/packs/linguist.sqlite (BRIEF_V2 §6.12, §6.14; DECISIONS D-270…D-279): translation
-- passages, the poetry corner and the reading-circle texts. Built by tools/packs/build_translation.py (translation_*)
-- and tools/packs/literature/build_literature.py (aozora_work, poem*, circle_*); each replaces only its own tables.
-- This file is the single source of truth: the builders execute these CREATE statements. Read-only in the app.

CREATE TABLE pack_meta (
    key TEXT NOT NULL PRIMARY KEY,
    value TEXT NOT NULL
);

-- A passage to translate. direction: JE (text Japanese, reference English) | EJ. genre: news | technical | legal |
-- literary | dialogue | military. level: the Japanese side's JLPT label (N5…N1); jlpt: its number. key_points: JSON
-- array of what a good translation must get right (the grader's completeness list). origin_kind: original | reader |
-- aozora | tatoeba; origin_ref: the graded-reader story id, Aozora work id, or Tatoeba sentence ids (JSON array).
-- sight_seconds: the sight-translation time limit. source: llm | verified | tatoeba (human translations, no badge).
CREATE TABLE translation_passage (
    id TEXT NOT NULL PRIMARY KEY,
    ord INTEGER NOT NULL,
    direction TEXT NOT NULL,
    genre TEXT NOT NULL,
    level TEXT NOT NULL,
    jlpt INTEGER NOT NULL,
    ilr TEXT NOT NULL,
    title TEXT NOT NULL,
    text TEXT NOT NULL,
    reference TEXT NOT NULL,
    register TEXT NOT NULL,
    key_points TEXT NOT NULL,
    notes TEXT NOT NULL,
    origin_kind TEXT NOT NULL,
    origin_ref TEXT,
    sight_seconds INTEGER NOT NULL,
    source TEXT NOT NULL,
    verified INTEGER NOT NULL
);
CREATE INDEX translation_passage_genre ON translation_passage(genre, direction);

-- Aozora Bunko works the pack quotes (public domain, checked per author at build time, D-276). colophon: the work's
-- 底本/入力/校正 notes and Aozora's volunteers' note, shown under every poem and circle text.
CREATE TABLE aozora_work (
    id TEXT NOT NULL PRIMARY KEY,
    title TEXT NOT NULL,
    author TEXT NOT NULL,
    author_reading TEXT NOT NULL,
    author_en TEXT NOT NULL,
    born TEXT NOT NULL,
    died TEXT NOT NULL,
    orthography TEXT NOT NULL,
    card_url TEXT NOT NULL,
    colophon TEXT NOT NULL
);

CREATE TABLE poem_theme (
    id TEXT NOT NULL PRIMARY KEY,
    ord INTEGER NOT NULL,
    ja TEXT NOT NULL,
    en TEXT NOT NULL
);

-- A modern poem (近代詩). body: the poem's lines, one blank line between stanzas. ruby: JSON [{start, base, reading}]
-- from the Aozora text (offsets in body). vocabulary: JSON [{word, reading, gloss, start}] (start = first offset of
-- word in body). paraphrase (plain modern Japanese), gloss (English) and note are LLM-drafted: source llm until reviewed.
CREATE TABLE poem (
    id TEXT NOT NULL PRIMARY KEY,
    ord INTEGER NOT NULL,
    work_id TEXT NOT NULL,
    title TEXT NOT NULL,
    title_en TEXT NOT NULL,
    author TEXT NOT NULL,
    body TEXT NOT NULL,
    ruby TEXT NOT NULL,
    vocabulary TEXT NOT NULL,
    paraphrase TEXT NOT NULL,
    gloss TEXT NOT NULL,
    note TEXT NOT NULL,
    source TEXT NOT NULL,
    verified INTEGER NOT NULL
);

CREATE TABLE poem_theme_member (
    theme_id TEXT NOT NULL,
    poem_id TEXT NOT NULL,
    PRIMARY KEY (theme_id, poem_id)
) WITHOUT ROWID;

-- A short Aozora text for the solo reading circle. body: one paragraph per line. summary_en is ours (llm).
CREATE TABLE circle_text (
    id TEXT NOT NULL PRIMARY KEY,
    ord INTEGER NOT NULL,
    work_id TEXT NOT NULL,
    title TEXT NOT NULL,
    title_en TEXT NOT NULL,
    author TEXT NOT NULL,
    level TEXT NOT NULL,
    body TEXT NOT NULL,
    ruby TEXT NOT NULL,
    summary_en TEXT NOT NULL,
    sentence_count INTEGER NOT NULL,
    source TEXT NOT NULL
);

-- The circle's sentences, split exactly as ReaderAnalyzer.sentences splits the body (offsets in body).
CREATE TABLE circle_sentence (
    text_id TEXT NOT NULL,
    idx INTEGER NOT NULL,
    start_offset INTEGER NOT NULL,
    end_offset INTEGER NOT NULL,
    text TEXT NOT NULL,
    PRIMARY KEY (text_id, idx)
) WITHOUT ROWID;

metaValue:
SELECT value FROM pack_meta WHERE key = ?;

passages:
SELECT * FROM translation_passage ORDER BY ord;

passageById:
SELECT * FROM translation_passage WHERE id = ?;

themes:
SELECT * FROM poem_theme ORDER BY ord;

poems:
SELECT * FROM poem ORDER BY ord;

poemsForTheme:
SELECT p.* FROM poem p JOIN poem_theme_member m ON m.poem_id = p.id WHERE m.theme_id = ? ORDER BY p.ord;

poemById:
SELECT * FROM poem WHERE id = ?;

themesOfPoem:
SELECT theme_id FROM poem_theme_member WHERE poem_id = ?;

work:
SELECT * FROM aozora_work WHERE id = ?;

circleTexts:
SELECT * FROM circle_text ORDER BY ord;

circleText:
SELECT * FROM circle_text WHERE id = ?;

circleSentences:
SELECT * FROM circle_sentence WHERE text_id = ? ORDER BY idx;
