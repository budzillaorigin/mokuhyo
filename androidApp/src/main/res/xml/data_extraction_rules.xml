<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ backup and device-to-device transfer. User data (the review database, settings, imported media) is
  kept. Excluded:
  - files/packs, files/models: content packs and AI models are large and re-created from the APK / re-downloaded.
  - files/tmp, files/tts: scratch space.
  - app.tsumugi.secrets: API tokens encrypted with an Android Keystore key, which never leaves the device, so a
    restored copy couldn't be decrypted anyway (and CLAUDE.md rule 6 keeps keys on the device).
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="packs" />
        <exclude domain="file" path="models" />
        <exclude domain="file" path="tmp" />
        <exclude domain="file" path="tts" />
        <exclude domain="sharedpref" path="app.tsumugi.secrets.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="packs" />
        <exclude domain="file" path="models" />
        <exclude domain="file" path="tmp" />
        <exclude domain="file" path="tts" />
        <exclude domain="sharedpref" path="app.tsumugi.secrets.xml" />
    </device-transfer>
</data-extraction-rules>
