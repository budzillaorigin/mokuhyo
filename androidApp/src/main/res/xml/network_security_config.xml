<?xml version="1.0" encoding="utf-8"?>
<!--
  F-03 / D-062: plain http is allowed so the learner's own servers work: Ollama, LM Studio, llama-server, Whisper,
  VOICEVOX and the sync server at http://192.168.x.x:port, http://homeserver, http://nas.local or a Tailscale name.
  A network security config can't express "private address ranges", and those hosts are typed in at run time, so
  the base config permits cleartext. The app itself never picks an http URL: every built-in host is https, and those
  hosts are listed below with cleartext switched off, so a mistake there fails loudly instead of going out in the
  clear. Trust anchors stay the system defaults (no user-installed CAs).
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">wanikani.com</domain>
        <domain includeSubdomains="true">huggingface.co</domain>
        <domain includeSubdomains="true">hf.co</domain>
        <domain includeSubdomains="true">github.com</domain>
        <domain includeSubdomains="true">githubusercontent.com</domain>
    </domain-config>
</network-security-config>
