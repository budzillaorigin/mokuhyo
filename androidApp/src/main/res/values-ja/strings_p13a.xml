<!-- Phase 13 (Android): pitch-accent perception test (BRIEF_V2 §6.7) and the mini-games Reflex and Atom (§6.9). -->
<resources>
    <!-- Pitch-accent test -->
    <string name="pt_missing">アクセント聞き取りテストには、アクセント音声パックが必要です。このパックの音声は、語ごとのアクセントを指定して作られています。端末の読み上げ音声ではアクセントが保証できないため、パックがないあいだはテストを表示しません。「私」→「設定」→「音声パック」からインストールしてください。</string>
    <string name="pt_intro">「〜が」をつけて読まれた単語を聞き、アクセントを答えます。3問続けて正解するとレベルが上がり、間違えると下がります。</string>
    <string name="pt_level">レベル %1$d／5</string>
    <string name="pt_level_1">2拍の語：平板・頭高・尾高</string>
    <string name="pt_level_2">2〜3拍の語：すべての型</string>
    <string name="pt_level_3">4拍までの語：同音語を優先</string>
    <string name="pt_level_4">どこで下がる？（2〜3拍）</string>
    <string name="pt_level_5">下がり目・どの語か（4拍まで）</string>
