<!-- Phase 13 (Android): pitch-accent perception test (BRIEF_V2 §6.7) and the mini-games Reflex and Atom (§6.9). -->
<resources>
    <!-- Pitch-accent test -->
    <string name="pt_missing">The pitch-accent test needs the pitch audio pack. Its clips are rendered with each word\'s accent set explicitly. The system voice can\'t guarantee an accent, so the test stays hidden without the pack. Install it in Me → Settings → Audio packs.</string>
    <string name="pt_intro">Listen to a word followed by が and name its accent. The test adapts: three right in a row move you up a level, a miss moves you down.</string>
    <string name="pt_level">Level %1$d of 5</string>
    <string name="pt_level_1">Two-mora words: flat, head-high or tail-high</string>
    <string name="pt_level_2">Two and three morae, every pattern</string>
    <string name="pt_level_3">Up to four morae, homophones first</string>
    <string name="pt_level_4">Where does the pitch fall? Two and three morae</string>
    <string name="pt_level_5">Downstep or which word, up to four morae</string>
    <string name="pt_drills">Drills</string>
    <string name="pt_drill_mixed">Adaptive mix</string>
    <string name="pt_drill_mixed_sub">Your level picks the question type</string>
    <string name="pt_drill_pattern">Pattern</string>
    <string name="pt_drill_pattern_sub">平板, 頭高, 中高 or 尾高</string>
    <string name="pt_drill_downstep">Downstep</string>
    <string name="pt_drill_downstep_sub">After which mora does the pitch fall?</string>
    <string name="pt_drill_pairs">Which word?</string>
    <string name="pt_drill_pairs_sub">Same kana, different accent (箸・橋・端)</string>
    <string name="pt_drill_minimal">Minimal pairs</string>
    <string name="pt_drill_minimal_sub">The ear-training pairs, on spaced repetition</string>
