<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Only for the explicitly online features: integrations (WaniKani, Bunpro), sync, model downloads. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Review reminders and download progress. Asked for after the first review session, not at launch (F-34). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Model downloads keep running in the background as a WorkManager foreground worker (F-13). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Model downloads warn before using a metered (mobile data) connection. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Speaking practice: recordings stay on the device (see platform/AudioCapture.kt). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Package visibility for the system speech recognizer and TTS engines (Android 11+). -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <!--
      Backups keep user data (reviews, settings, imported media) but skip content packs, AI models and the
      keystore-encrypted secrets: see res/xml/data_extraction_rules.xml (Android 12+) and backup_rules.xml.
      localeConfig lists the UI languages for Android 13+ per-app language settings.
    -->
    <application
        android:name=".TsumugiApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <!-- singleTop: text shared while the app is open arrives through onNewIntent instead of a second copy. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Share sheet: "Read in Tsumugi" imports shared text or a web page URL into the reader. -->
            <intent-filter android:label="@string/share_read_label">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <!--
              Files opened with Tsumugi (F-42): EPUB → reader, .apkg → Anki import, JSON → exam item bank,
              .srt/.vtt → a hint to use the media player. octet-stream is there because file managers report .apkg
              that way; app/OpenedFiles.kt checks the name and explains anything it can't open.
            -->
            <intent-filter android:label="@string/app_name">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:mimeType="application/epub+zip" />
                <data android:mimeType="application/x-subrip" />
                <data android:mimeType="text/srt" />
                <data android:mimeType="text/vtt" />
                <data android:mimeType="application/json" />
                <data android:mimeType="application/apkg" />
                <data android:mimeType="application/x-apkg" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
            <!-- Text-selection menu: "Look up in Tsumugi" opens the dictionary search. -->
            <intent-filter android:label="@string/process_text_label">
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <receiver android:name=".ReminderReceiver" android:exported="false" />

        <!-- G-15 home-screen widget (Glance): due reviews and the streak. -->
        <receiver
            android:name=".widget.TodayWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/today_widget_info" />
        </receiver>

        <!-- Exports handed to the share sheet (review CSV, PDF report, review verdicts); see res/xml/file_paths.xml. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- WorkManager's foreground service, declared with the type Android 14+ requires (ModelDownloadWorker). -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />
    </application>

</manifest>
