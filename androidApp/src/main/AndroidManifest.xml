<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Only for the explicitly online features: integrations (WaniKani, Bunpro), sync, model downloads. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Model downloads warn before using a metered (mobile data) connection. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Speaking practice: recordings stay on the device (see platform/AudioCapture.kt). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Package visibility for the system speech recognizer and TTS engines (Android 11+). -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:name=".TsumugiApplication"
        android:allowBackup="true"
        android:label="Tsumugi"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver android:name=".ReminderReceiver" android:exported="false" />
    </application>

</manifest>
